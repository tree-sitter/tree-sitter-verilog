// A.6 Behavioral statements.

expect _assertion_item_declaration
expect _block_identifier
expect _concurrent_assertion_statement
expect _hierarchical_block_identifier
expect _hierarchical_event_identifier
expect _hierarchical_task_identifier
expect _identifier
expect _signal_identifier
expect _simple_type
expect _variable_identifier
expect attribute_instance
expect block_item_declaration
expect checker_instantiation
expect clocking_identifier
expect concurrent_assertion_item
expect constant_expression
expect data_type
expect delay3
expect delay_value
expect drive_strength
expect dynamic_array_new
expect edge_identifier
expect expect_property_statement
expect expression
expect function_subroutine_call
expect hierarchical_identifier
expect inc_or_dec_expression
expect index_variable_identifier
expect integer_atom_type
expect integral_number
expect member_identifier
expect mintypmax_expression
expect net_lvalue
expect nonrange_variable_lvalue
expect ps_or_hierarchical_array_identifier
expect ps_or_hierarchical_sequence_identifier
expect ps_type_identifier
expect select1
expect subroutine_call
expect system_tf_call
expect type_reference
expect value_range
expect variable_lvalue

rule continuous_assign {
    seq(
        "assign",
        choice(
            seq(
                choice(
                    drive_strength,
                    blank(),
                ),
                choice(
                    delay3,
                    blank(),
                ),
                list_of_net_assignments,
            ),
            seq(
                choice(
                    delay_control,
                    blank(),
                ),
                list_of_variable_assignments,
            ),
        ),
        ";",
    )
}

rule list_of_net_assignments {
    prec_left(0, seq(
        net_assignment,
        repeat(prec_left(0, seq(
            ",",
            net_assignment,
        ))),
    ))
}

rule list_of_variable_assignments {
    prec_left(0, seq(
        variable_assignment,
        repeat(prec_left(0, seq(
            ",",
            variable_assignment,
        ))),
    ))
}

rule net_alias {
    prec_left(21, seq(
        "alias",
        net_lvalue,
        "=",
        prec_left(0, seq(
            seq(
                "=",
                net_lvalue,
            ),
            repeat(prec_left(0, seq(
                ",",
                seq(
                    "=",
                    net_lvalue,
                ),
            ))),
        )),
        ";",
    ))
}

rule net_assignment {
    prec_left(21, seq(
        net_lvalue,
        "=",
        expression,
    ))
}

rule initial_construct {
    seq(
        "initial",
        statement_or_null,
    )
}

rule always_construct {
    seq(
        always_keyword,
        statement,
    )
}

rule always_keyword {
    choice(
        "always",
        "always_comb",
        "always_latch",
        "always_ff",
    )
}

rule final_construct {
    seq(
        "final",
        function_statement,
    )
}

rule blocking_assignment {
    choice(
        prec_left(21, seq(
            variable_lvalue,
            "=",
            delay_or_event_control,
            expression,
        )),
        prec_left(21, seq(
            nonrange_variable_lvalue,
            "=",
            dynamic_array_new,
        )),
        operator_assignment,
    )
}

rule operator_assignment {
    prec_left(21, seq(
        variable_lvalue,
        assignment_operator,
        expression,
    ))
}

rule assignment_operator {
    choice(
        "=",
        "+=",
        "-=",
        "*=",
        "/=",
        "%=",
        "&=",
        "|=",
        "^=",
        "<<=",
        ">>=",
        "<<<=",
        ">>>=",
    )
}

rule nonblocking_assignment {
    prec_left(21, seq(
        variable_lvalue,
        "<=",
        choice(
            delay_or_event_control,
            blank(),
        ),
        expression,
    ))
}

rule procedural_continuous_assignment {
    choice(
        seq(
            "assign",
            variable_assignment,
        ),
        seq(
            "deassign",
            variable_lvalue,
        ),
        seq(
            "force",
            variable_assignment,
        ),
        seq(
            "force",
            net_assignment,
        ),
        seq(
            "release",
            variable_lvalue,
        ),
        seq(
            "release",
            net_lvalue,
        ),
    )
}

rule variable_assignment {
    prec_left(21, seq(
        variable_lvalue,
        "=",
        expression,
    ))
}

rule action_block {
    choice(
        statement_or_null,
        seq(
            choice(
                statement,
                blank(),
            ),
            "else",
            statement_or_null,
        ),
    )
}

rule seq_block {
    seq(
        "begin",
        choice(
            prec_left(0, seq(
                ":",
                _block_identifier,
            )),
            blank(),
        ),
        repeat(block_item_declaration),
        repeat(statement_or_null),
        "end",
        choice(
            prec_left(0, seq(
                ":",
                _block_identifier,
            )),
            blank(),
        ),
    )
}

rule par_block {
    seq(
        "fork",
        choice(
            prec_left(0, seq(
                ":",
                _block_identifier,
            )),
            blank(),
        ),
        repeat(block_item_declaration),
        repeat(statement_or_null),
        join_keyword,
        choice(
            prec_left(0, seq(
                ":",
                _block_identifier,
            )),
            blank(),
        ),
    )
}

rule join_keyword {
    choice(
        "join",
        "join_any",
        "join_none",
    )
}

rule statement_or_null {
    choice(
        statement,
        seq(
            repeat(attribute_instance),
            ";",
        ),
    )
}

rule statement {
    seq(
        choice(
            prec_left(0, seq(
                _block_identifier,
                ":",
            )),
            blank(),
        ),
        repeat(attribute_instance),
        statement_item,
    )
}

rule statement_item {
    choice(
        seq(
            blocking_assignment,
            ";",
        ),
        seq(
            nonblocking_assignment,
            ";",
        ),
        seq(
            procedural_continuous_assignment,
            ";",
        ),
        seq(
            system_tf_call,
            ";",
        ),
        case_statement,
        conditional_statement,
        seq(
            inc_or_dec_expression,
            ";",
        ),
        disable_statement,
        event_trigger,
        loop_statement,
        jump_statement,
        par_block,
        seq_block,
        procedural_timing_control_statement,
        wait_statement,
        _procedural_assertion_statement,
        seq(
            clocking_drive,
            ";",
        ),
        randcase_statement,
        expect_property_statement,
    )
}

rule function_statement { statement }

rule function_statement_or_null {
    choice(
        function_statement,
        seq(
            repeat(attribute_instance),
            ";",
        ),
    )
}

rule variable_identifier_list {
    prec_left(0, seq(
        _variable_identifier,
        repeat(prec_left(0, seq(
            ",",
            _variable_identifier,
        ))),
    ))
}

rule procedural_timing_control_statement {
    seq(
        _procedural_timing_control,
        statement_or_null,
    )
}

rule delay_or_event_control {
    choice(
        delay_control,
        event_control,
        seq(
            "repeat",
            "(",
            expression,
            ")",
            event_control,
        ),
    )
}

rule delay_control {
    seq(
        "#",
        choice(
            delay_value,
            seq(
                "(",
                mintypmax_expression,
                ")",
            ),
        ),
    )
}

rule event_control {
    choice(
        seq(
            "@",
            _hierarchical_event_identifier,
        ),
        seq(
            "@",
            "(",
            event_expression,
            ")",
        ),
        "@*",
        seq(
            "@",
            "(",
            "*",
            ")",
        ),
        seq(
            "@",
            ps_or_hierarchical_sequence_identifier,
        ),
    )
}

rule event_expression {
    choice(
        prec_left(0, seq(
            event_expression,
            "or",
            event_expression,
        )),
        prec_left(0, seq(
            event_expression,
            ",",
            event_expression,
        )),
        seq(
            choice(
                edge_identifier,
                blank(),
            ),
            expression,
        ),
    )
}

rule _procedural_timing_control {
    choice(
        delay_control,
        event_control,
        cycle_delay,
    )
}

rule jump_statement {
    choice(
        seq(
            "return",
            choice(
                expression,
                blank(),
            ),
            ";",
        ),
        seq(
            "break",
            ";",
        ),
        seq(
            "continue",
            ";",
        ),
    )
}

rule wait_statement {
    choice(
        seq(
            "wait",
            "(",
            expression,
            ")",
            statement_or_null,
        ),
        seq(
            "wait",
            "fork",
            ";",
        ),
        seq(
            "wait_order",
            "(",
            prec_left(0, seq(
                hierarchical_identifier,
                repeat(prec_left(0, seq(
                    ",",
                    hierarchical_identifier,
                ))),
            )),
            ")",
            action_block,
        ),
    )
}

rule event_trigger {
    choice(
        seq(
            "->",
            _hierarchical_event_identifier,
            ";",
        ),
        seq(
            "->>",
            choice(
                delay_or_event_control,
                blank(),
            ),
            _hierarchical_event_identifier,
            ";",
        ),
    )
}

rule disable_statement {
    choice(
        seq(
            "disable",
            _hierarchical_task_identifier,
            ";",
        ),
        seq(
            "disable",
            _hierarchical_block_identifier,
            ";",
        ),
        seq(
            "disable",
            "fork",
            ";",
        ),
    )
}

rule conditional_statement {
    prec_left(0, seq(
        choice(
            unique_priority,
            blank(),
        ),
        "if",
        "(",
        cond_predicate,
        ")",
        statement_or_null,
        choice(
            prec_left(0, seq(
                "else",
                statement_or_null,
            )),
            blank(),
        ),
    ))
}

rule unique_priority {
    choice(
        "unique",
        "unique0",
        "priority",
    )
}

rule cond_predicate {
    prec_left(37, seq(
        _expression_or_cond_pattern,
        repeat(prec_left(0, seq(
            "&&&",
            _expression_or_cond_pattern,
        ))),
    ))
}

rule _expression_or_cond_pattern {
    choice(
        expression,
        cond_pattern,
    )
}

rule cond_pattern {
    prec_left(26, seq(
        expression,
        "matches",
        pattern,
    ))
}

rule case_statement {
    seq(
        choice(
            unique_priority,
            blank(),
        ),
        seq(
            case_keyword,
            "(",
            case_expression,
            ")",
            choice(
                repeat1(case_item),
                seq(
                    "matches",
                    repeat1(case_pattern_item),
                ),
                seq(
                    "inside",
                    repeat1(case_inside_item),
                ),
            ),
        ),
        "endcase",
    )
}

rule case_keyword {
    choice(
        "case",
        "casez",
        "casex",
    )
}

rule case_expression { expression }

rule case_item {
    choice(
        seq(
            prec_left(0, seq(
                case_item_expression,
                repeat(prec_left(0, seq(
                    ",",
                    case_item_expression,
                ))),
            )),
            ":",
            statement_or_null,
        ),
        seq(
            "default",
            choice(
                ":",
                blank(),
            ),
            statement_or_null,
        ),
    )
}

rule case_pattern_item {
    choice(
        seq(
            pattern,
            choice(
                prec_left(0, seq(
                    "&&&",
                    expression,
                )),
                blank(),
            ),
            ":",
            statement_or_null,
        ),
        seq(
            "default",
            choice(
                ":",
                blank(),
            ),
            statement_or_null,
        ),
    )
}

rule case_inside_item {
    choice(
        seq(
            open_range_list,
            ":",
            statement_or_null,
        ),
        seq(
            "default",
            choice(
                ":",
                blank(),
            ),
            statement_or_null,
        ),
    )
}

rule case_item_expression { expression }

rule randcase_statement {
    seq(
        "randcase",
        randcase_item,
        repeat(randcase_item),
        "endcase",
    )
}

rule randcase_item {
    seq(
        expression,
        ":",
        statement_or_null,
    )
}

rule open_range_list {
    prec_left(0, seq(
        open_value_range,
        repeat(prec_left(0, seq(
            ",",
            open_value_range,
        ))),
    ))
}

rule open_value_range { value_range }

rule pattern {
    choice(
        seq(
            ".",
            _variable_identifier,
        ),
        ".*",
        constant_expression,
        seq(
            "tagged",
            member_identifier,
            choice(
                pattern,
                blank(),
            ),
        ),
        seq(
            "'{",
            prec_left(0, seq(
                pattern,
                repeat(prec_left(0, seq(
                    ",",
                    pattern,
                ))),
            )),
            "}",
        ),
        seq(
            "'{",
            prec_left(0, seq(
                seq(
                    member_identifier,
                    ":",
                    pattern,
                ),
                repeat(prec_left(0, seq(
                    ",",
                    seq(
                        member_identifier,
                        ":",
                        pattern,
                    ),
                ))),
            )),
            "}",
        ),
    )
}

rule assignment_pattern {
    seq(
        "'{",
        choice(
            prec_left(0, seq(
                expression,
                repeat(prec_left(0, seq(
                    ",",
                    expression,
                ))),
            )),
            prec_left(0, seq(
                seq(
                    _array_pattern_key,
                    ":",
                    expression,
                ),
                repeat(prec_left(0, seq(
                    ",",
                    seq(
                        _array_pattern_key,
                        ":",
                        expression,
                    ),
                ))),
            )),
            seq(
                constant_expression,
                "{",
                prec_left(0, seq(
                    expression,
                    repeat(prec_left(0, seq(
                        ",",
                        expression,
                    ))),
                )),
                "}",
            ),
        ),
        "}",
    )
}

rule _structure_pattern_key {
    choice(
        member_identifier,
        assignment_pattern_key,
    )
}

rule _array_pattern_key {
    choice(
        constant_expression,
        assignment_pattern_key,
    )
}

rule assignment_pattern_key {
    choice(
        _simple_type,
        "default",
    )
}

rule assignment_pattern_expression {
    seq(
        choice(
            _assignment_pattern_expression_type,
            blank(),
        ),
        assignment_pattern,
    )
}

rule _assignment_pattern_expression_type {
    choice(
        ps_type_identifier,
        integer_atom_type,
        type_reference,
    )
}

rule constant_assignment_pattern_expression { assignment_pattern_expression }

rule assignment_pattern_net_lvalue {
    seq(
        "'{",
        prec_left(0, seq(
            net_lvalue,
            repeat(prec_left(0, seq(
                ",",
                net_lvalue,
            ))),
        )),
        "}",
    )
}

rule assignment_pattern_variable_lvalue {
    seq(
        "'{",
        prec_left(0, seq(
            variable_lvalue,
            repeat(prec_left(0, seq(
                ",",
                variable_lvalue,
            ))),
        )),
        "}",
    )
}

rule loop_statement {
    choice(
        seq(
            "forever",
            statement_or_null,
        ),
        seq(
            "repeat",
            "(",
            expression,
            ")",
            statement_or_null,
        ),
        seq(
            "while",
            "(",
            expression,
            ")",
            statement_or_null,
        ),
        seq(
            "for",
            "(",
            choice(
                for_initialization,
                blank(),
            ),
            ";",
            choice(
                expression,
                blank(),
            ),
            ";",
            choice(
                for_step,
                blank(),
            ),
            ")",
            statement_or_null,
        ),
        seq(
            "do",
            statement_or_null,
            "while",
            "(",
            expression,
            ")",
            ";",
        ),
        seq(
            "foreach",
            "(",
            ps_or_hierarchical_array_identifier,
            "[",
            choice(
                loop_variables1,
                blank(),
            ),
            "]",
            ")",
            statement,
        ),
    )
}

rule for_initialization {
    choice(
        list_of_variable_assignments,
        prec_left(0, seq(
            for_variable_declaration,
            repeat(prec_left(0, seq(
                ",",
                for_variable_declaration,
            ))),
        )),
    )
}

rule for_variable_declaration {
    seq(
        choice(
            "var",
            blank(),
        ),
        data_type,
        prec_left(0, seq(
            seq(
                _variable_identifier,
                "=",
                expression,
            ),
            repeat(prec_left(0, seq(
                ",",
                seq(
                    _variable_identifier,
                    "=",
                    expression,
                ),
            ))),
        )),
    )
}

rule for_step {
    prec_left(0, seq(
        _for_step_assignment,
        repeat(prec_left(0, seq(
            ",",
            _for_step_assignment,
        ))),
    ))
}

rule _for_step_assignment {
    choice(
        operator_assignment,
        inc_or_dec_expression,
        function_subroutine_call,
    )
}

rule loop_variables1 {
    seq(
        index_variable_identifier,
        repeat(prec_left(0, seq(
            ",",
            choice(
                index_variable_identifier,
                blank(),
            ),
        ))),
    )
}

rule subroutine_call_statement {
    choice(
        seq(
            subroutine_call,
            ";",
        ),
        seq(
            "void'",
            "(",
            function_subroutine_call,
            ")",
            ";",
        ),
    )
}

rule _assertion_item {
    choice(
        concurrent_assertion_item,
        deferred_immediate_assertion_item,
    )
}

rule deferred_immediate_assertion_item {
    seq(
        choice(
            prec_left(0, seq(
                _block_identifier,
                ":",
            )),
            blank(),
        ),
        _deferred_immediate_assertion_statement,
    )
}

rule _procedural_assertion_statement {
    choice(
        _concurrent_assertion_statement,
        _immediate_assertion_statement,
        checker_instantiation,
    )
}

rule _immediate_assertion_statement {
    choice(
        _simple_immediate_assertion_statement,
        _deferred_immediate_assertion_statement,
    )
}

rule _simple_immediate_assertion_statement {
    choice(
        simple_immediate_assert_statement,
        simple_immediate_assume_statement,
        simple_immediate_cover_statement,
    )
}

rule simple_immediate_assert_statement {
    seq(
        "assert",
        "(",
        expression,
        ")",
        action_block,
    )
}

rule simple_immediate_assume_statement {
    seq(
        "assume",
        "(",
        expression,
        ")",
        action_block,
    )
}

rule simple_immediate_cover_statement {
    seq(
        "cover",
        "(",
        expression,
        ")",
        statement_or_null,
    )
}

rule _deferred_immediate_assertion_statement {
    choice(
        deferred_immediate_assert_statement,
        deferred_immediate_assume_statement,
        deferred_immediate_cover_statement,
    )
}

rule deferred_immediate_assert_statement {
    seq(
        "assert",
        choice(
            "#0",
            "final",
        ),
        "(",
        expression,
        ")",
        action_block,
    )
}

rule deferred_immediate_assume_statement {
    seq(
        "assume",
        choice(
            "#0",
            "final",
        ),
        "(",
        expression,
        ")",
        action_block,
    )
}

rule deferred_immediate_cover_statement {
    seq(
        "cover",
        choice(
            "#0",
            "final",
        ),
        "(",
        expression,
        ")",
        statement_or_null,
    )
}

rule clocking_declaration {
    choice(
        seq(
            choice(
                "default",
                blank(),
            ),
            "clocking",
            choice(
                clocking_identifier,
                blank(),
            ),
            clocking_event,
            ";",
            repeat(clocking_item),
            "endclocking",
            choice(
                prec_left(0, seq(
                    ":",
                    clocking_identifier,
                )),
                blank(),
            ),
        ),
        seq(
            "global",
            "clocking",
            choice(
                clocking_identifier,
                blank(),
            ),
            clocking_event,
            ";",
            "endclocking",
            choice(
                prec_left(0, seq(
                    ":",
                    clocking_identifier,
                )),
                blank(),
            ),
        ),
    )
}

rule clocking_event {
    seq(
        "@",
        choice(
            _identifier,
            seq(
                "(",
                event_expression,
                ")",
            ),
        ),
    )
}

rule clocking_item {
    choice(
        seq(
            "default",
            default_skew,
            ";",
        ),
        seq(
            clocking_direction,
            list_of_clocking_decl_assign,
            ";",
        ),
        seq(
            repeat(attribute_instance),
            _assertion_item_declaration,
        ),
    )
}

rule default_skew {
    choice(
        seq(
            "input",
            clocking_skew,
        ),
        seq(
            "output",
            clocking_skew,
        ),
        seq(
            "input",
            clocking_skew,
            "output",
            clocking_skew,
        ),
    )
}

rule clocking_direction {
    choice(
        seq(
            "input",
            choice(
                clocking_skew,
                blank(),
            ),
        ),
        seq(
            "output",
            choice(
                clocking_skew,
                blank(),
            ),
        ),
        seq(
            "input",
            choice(
                clocking_skew,
                blank(),
            ),
            "output",
            choice(
                clocking_skew,
                blank(),
            ),
        ),
        seq(
            "inout",
        ),
    )
}

rule list_of_clocking_decl_assign {
    prec_left(0, seq(
        clocking_decl_assign,
        repeat(prec_left(0, seq(
            ",",
            clocking_decl_assign,
        ))),
    ))
}

rule clocking_decl_assign {
    seq(
        _signal_identifier,
        choice(
            prec_left(0, seq(
                "=",
                expression,
            )),
            blank(),
        ),
    )
}

rule clocking_skew {
    choice(
        seq(
            edge_identifier,
            choice(
                delay_control,
                blank(),
            ),
        ),
        delay_control,
    )
}

rule clocking_drive {
    prec_left(21, seq(
        clockvar_expression,
        "<=",
        choice(
            cycle_delay,
            blank(),
        ),
        expression,
    ))
}

rule cycle_delay {
    prec_left(0, seq(
        "##",
        choice(
            integral_number,
            _identifier,
            seq(
                "(",
                expression,
                ")",
            ),
        ),
    ))
}

rule clockvar { hierarchical_identifier }

rule clockvar_expression {
    seq(
        clockvar,
        choice(
            select1,
            blank(),
        ),
    )
}
