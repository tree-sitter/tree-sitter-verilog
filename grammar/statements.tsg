// A.6 Behavioral statements.

let dsl = import("helpers.tsg")

expect _assertion_item_declaration
expect _block_identifier
expect _concurrent_assertion_statement
expect _hierarchical_block_identifier
expect _hierarchical_event_identifier
expect _hierarchical_task_identifier
expect _identifier
expect _signal_identifier
expect _simple_type
expect _variable_identifier
expect attribute_instance
expect block_item_declaration
expect checker_instantiation
expect clocking_identifier
expect concurrent_assertion_item
expect constant_expression
expect data_type
expect delay3
expect delay_value
expect drive_strength
expect dynamic_array_new
expect edge_identifier
expect expect_property_statement
expect expression
expect function_subroutine_call
expect hierarchical_identifier
expect inc_or_dec_expression
expect index_variable_identifier
expect integer_atom_type
expect integral_number
expect member_identifier
expect mintypmax_expression
expect net_lvalue
expect nonrange_variable_lvalue
expect ps_or_hierarchical_array_identifier
expect ps_or_hierarchical_sequence_identifier
expect ps_type_identifier
expect select1
expect subroutine_call
expect system_tf_call
expect type_reference
expect value_range
expect variable_lvalue

// A.6 Behavioral statements

// A.6.1 Continuous assignment and net alias statements

rule continuous_assign {
    seq(
        "assign",
        choice(
            seq(
                optional(drive_strength),
                optional(delay3),
                list_of_net_assignments,
            ),
            seq(
                optional(delay_control),
                list_of_variable_assignments,
            ),
        ),
        ";",
    )
}

rule list_of_net_assignments { dsl::sep1(",", net_assignment) }

rule list_of_variable_assignments { dsl::sep1(",", variable_assignment) }

rule net_alias {
    prec_left(dsl::PREC.ASSIGN, seq(
        "alias", net_lvalue, "=", dsl::sep1(",", seq("=", net_lvalue)), ";",
    ))
}

rule net_assignment {
    prec_left(dsl::PREC.ASSIGN,
        seq(net_lvalue, "=", expression),
    )
}

// A.6.2 Procedural blocks and assignments

rule initial_construct { seq("initial", statement_or_null) }

rule always_construct { seq(always_keyword, statement) }

rule always_keyword {
    choice(
        "always", "always_comb", "always_latch", "always_ff",
    )
}

rule final_construct { seq("final", function_statement) }

rule blocking_assignment {
    choice(
        prec_left(dsl::PREC.ASSIGN, seq(
            variable_lvalue, "=", delay_or_event_control, expression,
        )),
        prec_left(dsl::PREC.ASSIGN, seq(
            nonrange_variable_lvalue, "=", dynamic_array_new,
        )),
        // seq(
        //   optional(choice(
        //     seq($.implicit_class_handle, '.'),
        //     $.class_scope,
        //     $.package_scope
        //   )),
        //   $._hierarchical_variable_identifier
        //   $.select,
        //   '=',
        //   $.class_new
        // ),
        operator_assignment,
    )
}

rule operator_assignment {
    prec_left(dsl::PREC.ASSIGN,
        seq(variable_lvalue, assignment_operator, expression),
    )
}

rule assignment_operator {
    choice(
        "=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=", "<<<=", ">>>=",
    )
}

rule nonblocking_assignment {
    prec_left(dsl::PREC.ASSIGN, seq(
        variable_lvalue,
        "<=",
        optional(delay_or_event_control),
        expression,
    ))
}

rule procedural_continuous_assignment {
    choice(
        seq("assign", variable_assignment),
        seq("deassign", variable_lvalue),
        seq("force", variable_assignment),
        seq("force", net_assignment),
        seq("release", variable_lvalue),
        seq("release", net_lvalue),
    )
}

rule variable_assignment {
    prec_left(dsl::PREC.ASSIGN, seq(
        variable_lvalue,
        "=",
        expression,
    ))
}

// A.6.3 Parallel and sequential blocks

rule action_block {
    choice(
        statement_or_null,
        seq(optional(statement), "else", statement_or_null),
    )
}

rule seq_block {
    seq(
        "begin", dsl::optseq([":", _block_identifier]),
        repeat(block_item_declaration),
        repeat(statement_or_null),
        "end", dsl::optseq([":", _block_identifier]),
    )
}

rule par_block {
    seq(
        "fork", dsl::optseq([":", _block_identifier]),
        repeat(block_item_declaration),
        repeat(statement_or_null),
        join_keyword, dsl::optseq([":", _block_identifier]),
    )
}

rule join_keyword { choice("join", "join_any", "join_none") }

// A.6.4 Statements

rule statement_or_null {
    choice(
        statement,
        seq(repeat(attribute_instance), ";"),
    )
}

rule statement {
    seq(
        dsl::optseq([_block_identifier, ":"]),
        repeat(attribute_instance),
        statement_item,
    )
}

rule statement_item {
    choice(
        seq(blocking_assignment, ";"),
        seq(nonblocking_assignment, ";"),
        seq(procedural_continuous_assignment, ";"),
        seq(system_tf_call, ";"),
        case_statement,
        conditional_statement,
        seq(inc_or_dec_expression, ";"),
        // $.subroutine_call_statement,
        disable_statement,
        event_trigger,
        loop_statement,
        jump_statement,
        par_block,
        seq_block,
        procedural_timing_control_statement,
        wait_statement,
        _procedural_assertion_statement,
        seq(clocking_drive, ";"),
        // $.randsequence_statement,
        randcase_statement,
        expect_property_statement,
    )
}

rule function_statement { statement }

rule function_statement_or_null {
    choice(
        function_statement,
        seq(repeat(attribute_instance), ";"),
    )
}

rule variable_identifier_list { dsl::sep1(",", _variable_identifier) }

// A.6.5 Timing control statements

rule procedural_timing_control_statement {
    seq(
        _procedural_timing_control, statement_or_null, // statement_or_null1
    )
}

rule delay_or_event_control {
    choice(
        delay_control,
        event_control,
        seq("repeat", "(", expression, ")", event_control),
    )
}

rule delay_control {
    seq("#", choice(
        delay_value,
        seq("(", mintypmax_expression, ")"),
    ))
}

rule event_control {
    choice(
        seq("@", _hierarchical_event_identifier),
        seq("@", "(", event_expression, ")"),
        "@*",
        seq("@", "(", "*", ")"),
        seq("@", ps_or_hierarchical_sequence_identifier),
    )
}

rule event_expression {
    choice( // reordered : brake recursion
        prec_left(0, seq(event_expression, "or", event_expression)),
        prec_left(0, seq(event_expression, ",", event_expression)),
        seq(
            optional(edge_identifier),
            expression,
        ), // reordered : help parser
        // seq(
        //   optional($.edge_identifier),
        //   $.expression,
        //   optseq('iff', $.expression)
        // ),
        // seq(
        //   $.sequence_instance,
        //   optseq('iff', $.expression)
        // ),
        // seq('(', $.event_expression, ')')
    )
}

// event_expression_2: $ => choice( // reordered : help parser
//   seq($.edge_identifier, $.expression), // reordered : help parser
//   seq(
//     optional($.edge_identifier),
//     $.expression,
//     optseq('iff', $.expression)
//   ),
//   // seq(
//   //   $.sequence_instance,
//   //   optseq('iff', $.expression)
//   // ),
//   seq('(', $.event_expression, ')')
// ),

rule _procedural_timing_control {
    choice(
        delay_control,
        event_control,
        cycle_delay,
    )
}

rule jump_statement {
    choice(
        seq("return", optional(expression), ";"),
        seq("break", ";"),
        seq("continue", ";"),
    )
}

rule wait_statement {
    choice(
        seq("wait", "(", expression, ")", statement_or_null),
        seq("wait", "fork", ";"),
        seq("wait_order", "(", dsl::sep1(",", hierarchical_identifier), ")", action_block),
    )
}

rule event_trigger {
    choice(
        seq("->", _hierarchical_event_identifier, ";"),
        seq("->>", optional(delay_or_event_control), _hierarchical_event_identifier, ";"),
    )
}

rule disable_statement {
    choice(
        seq("disable", _hierarchical_task_identifier, ";"),
        seq("disable", _hierarchical_block_identifier, ";"),
        seq("disable", "fork", ";"),
    )
}

// A.6.6 Conditional statements

rule conditional_statement {
    prec_left(0, seq(
        optional(unique_priority),
        "if", "(", cond_predicate, ")", statement_or_null,
        // repseq('else', 'if', '(', $.cond_predicate, ')', $.statement_or_null),
        dsl::optseq(["else", statement_or_null]),
    ))
}

rule unique_priority { choice("unique", "unique0", "priority") }

rule cond_predicate { dsl::psep1(dsl::PREC.PARENT, "&&&", _expression_or_cond_pattern) }

// FIXME precedence

rule _expression_or_cond_pattern {
    choice(
        expression,
        cond_pattern,
    )
}

rule cond_pattern { prec_left(dsl::PREC.MATCHES, seq(expression, "matches", pattern)) }

// A.6.7 Case statements

rule case_statement {
    seq(
        optional(unique_priority),
        seq(
            case_keyword,
            "(", case_expression, ")",
            choice(
                repeat1(case_item),
                seq("matches", repeat1(case_pattern_item)),
                seq("inside", repeat1(case_inside_item)), // only case
            ),
        ),
        "endcase",
    )
}

rule case_keyword { choice("case", "casez", "casex") }

rule case_expression { expression }

rule case_item {
    choice(
        seq(dsl::sep1(",", case_item_expression), ":", statement_or_null),
        seq("default", optional(":"), statement_or_null),
    )
}

rule case_pattern_item {
    choice(
        seq(pattern, dsl::optseq(["&&&", expression]), ":", statement_or_null),
        seq("default", optional(":"), statement_or_null),
    )
}

rule case_inside_item {
    choice(
        seq(open_range_list, ":", statement_or_null),
        seq("default", optional(":"), statement_or_null),
    )
}

rule case_item_expression { expression }

rule randcase_statement {
    seq(
        "randcase", randcase_item, repeat(randcase_item), "endcase",
    )
}

rule randcase_item { seq(expression, ":", statement_or_null) }

rule open_range_list { dsl::sep1(",", open_value_range) }

rule open_value_range { value_range }

// A.6.7.1 Patterns

rule pattern {
    choice(
        seq(".", _variable_identifier),
        ".*",
        constant_expression,
        seq("tagged", member_identifier, optional(pattern)),
        seq("'{", dsl::sep1(",", pattern), "}"),
        seq("'{", dsl::sep1(",", seq(member_identifier, ":", pattern)), "}"),
    )
}

rule assignment_pattern {
    seq(
        "'{",
        choice(
            dsl::sep1(",", expression),
            // sep1(',', seq($._structure_pattern_key, ':', $.expression)),
            dsl::sep1(",", seq(_array_pattern_key, ":", expression)),
            seq(constant_expression, "{", dsl::sep1(",", expression), "}"),
        ),
        "}",
    )
}

rule _structure_pattern_key {
    choice(
        member_identifier,
        assignment_pattern_key,
    )
}

rule _array_pattern_key {
    choice(
        constant_expression,
        assignment_pattern_key,
    )
}

rule assignment_pattern_key {
    choice(
        _simple_type,
        "default",
    )
}

rule assignment_pattern_expression {
    seq(
        optional(_assignment_pattern_expression_type), assignment_pattern,
    )
}

rule _assignment_pattern_expression_type {
    choice(
        ps_type_identifier,
        // $.ps_parameter_identifier,
        integer_atom_type,
        type_reference,
    )
}

rule constant_assignment_pattern_expression { assignment_pattern_expression }

rule assignment_pattern_net_lvalue {
    seq(
        "'{", dsl::sep1(",", net_lvalue), "}",
    )
}

rule assignment_pattern_variable_lvalue {
    seq(
        "'{", dsl::sep1(",", variable_lvalue), "}",
    )
}

// A.6.8 Looping statements

rule loop_statement {
    choice(
        seq("forever", statement_or_null),
        seq("repeat", "(", expression, ")", statement_or_null),
        seq("while", "(", expression, ")", statement_or_null),
        seq(
            "for", "(",
            optional(for_initialization), ";",
            optional(expression), ";",
            optional(for_step),
            ")",
            statement_or_null,
        ),
        seq("do", statement_or_null, "while", "(", expression, ")", ";"),
        seq(
            "foreach", "(",
            ps_or_hierarchical_array_identifier,
            "[",
            optional(loop_variables1),
            "]",
            ")",
            statement,
        ),
    )
}

rule for_initialization {
    choice(
        list_of_variable_assignments,
        dsl::sep1(",", for_variable_declaration),
    )
}

rule for_variable_declaration {
    seq(
        optional("var"), data_type,
        dsl::sep1(",", seq(
            _variable_identifier, "=", expression,
        )),
    )
}

rule for_step { dsl::sep1(",", _for_step_assignment) }

rule _for_step_assignment {
    choice(
        operator_assignment,
        inc_or_dec_expression,
        function_subroutine_call,
    )
}

rule loop_variables1 {
    seq(
        index_variable_identifier,
        dsl::repseq([",", optional(index_variable_identifier)]),
    )
}

// A.6.9 Subroutine call statements

rule subroutine_call_statement {
    choice(
        seq(subroutine_call, ";"),
        seq("void'", "(", function_subroutine_call, ")", ";"),
    )
}

// A.6.10 Assertion statements

rule _assertion_item {
    choice(
        concurrent_assertion_item,
        deferred_immediate_assertion_item,
    )
}

rule deferred_immediate_assertion_item {
    seq(
        dsl::optseq(
            [_block_identifier, ":"],
        ),
        _deferred_immediate_assertion_statement,
    )
}

rule _procedural_assertion_statement {
    choice(
        _concurrent_assertion_statement,
        _immediate_assertion_statement,
        checker_instantiation,
    )
}

rule _immediate_assertion_statement {
    choice(
        _simple_immediate_assertion_statement,
        _deferred_immediate_assertion_statement,
    )
}

rule _simple_immediate_assertion_statement {
    choice(
        simple_immediate_assert_statement,
        simple_immediate_assume_statement,
        simple_immediate_cover_statement,
    )
}

rule simple_immediate_assert_statement {
    seq(
        "assert", "(", expression, ")", action_block,
    )
}

rule simple_immediate_assume_statement {
    seq(
        "assume", "(", expression, ")", action_block,
    )
}

rule simple_immediate_cover_statement {
    seq(
        "cover", "(", expression, ")", statement_or_null,
    )
}

rule _deferred_immediate_assertion_statement {
    choice(
        deferred_immediate_assert_statement,
        deferred_immediate_assume_statement,
        deferred_immediate_cover_statement,
    )
}

rule deferred_immediate_assert_statement {
    seq(
        "assert",
        choice("#0", "final"),
        "(", expression, ")", action_block,
    )
}

rule deferred_immediate_assume_statement {
    seq(
        "assume",
        choice("#0", "final"),
        "(", expression, ")", action_block,
    )
}

rule deferred_immediate_cover_statement {
    seq(
        "cover",
        choice("#0", "final"),
        "(", expression, ")", statement_or_null,
    )
}

// A.6.11 Clocking block

rule clocking_declaration {
    choice(
        seq(
            optional("default"),
            "clocking", optional(clocking_identifier), clocking_event, ";",
            repeat(clocking_item),
            "endclocking", dsl::optseq([":", clocking_identifier]),
        ),
        seq(
            "global",
            "clocking", optional(clocking_identifier), clocking_event, ";",
            "endclocking", dsl::optseq([":", clocking_identifier]),
        ),
    )
}

rule clocking_event {
    seq("@", choice(
        _identifier,
        seq("(", event_expression, ")"),
    ))
}

rule clocking_item {
    choice(
        seq("default", default_skew, ";"),
        seq(clocking_direction, list_of_clocking_decl_assign, ";"),
        seq(repeat(attribute_instance), _assertion_item_declaration),
    )
}

rule default_skew {
    choice(
        seq("input", clocking_skew),
        seq("output", clocking_skew),
        seq("input", clocking_skew, "output", clocking_skew),
    )
}

rule clocking_direction {
    choice(
        seq("input", optional(clocking_skew)),
        seq("output", optional(clocking_skew)),
        seq("input", optional(clocking_skew), "output", optional(clocking_skew)),
        seq("inout"),
    )
}

rule list_of_clocking_decl_assign { dsl::sep1(",", clocking_decl_assign) }

rule clocking_decl_assign { seq(_signal_identifier, dsl::optseq(["=", expression])) }

rule clocking_skew {
    choice(
        seq(edge_identifier, optional(delay_control)),
        delay_control,
    )
}

rule clocking_drive {
    prec_left(dsl::PREC.ASSIGN,
        seq(clockvar_expression, "<=", optional(cycle_delay), expression),
    )
}

rule cycle_delay {
    prec_left(0, seq("##", choice(
        integral_number,
        _identifier,
        seq("(", expression, ")"),
    )))
}

rule clockvar { hierarchical_identifier }

rule clockvar_expression {
    seq(
        clockvar,
        optional(select1),
    )
}
