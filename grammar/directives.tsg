// Compiler directives.

let dsl = import("helpers.tsg")

expect _description
expect _identifier
expect expression
expect simple_identifier
expect time_literal
expect unsigned_number

rule source_file { repeat(_description) }

// 22. Compiler directives

// 22-1 `include

rule double_quoted_string {
    seq(
        "\"", token_immediate(prec(1, regexp(r#"[^\\"\n]+"#))), "\"",
    )
}

rule include_compiler_directive_standard {
    seq(
        "<", token_immediate(prec(1, regexp(r"[^\\>\n]+"))), ">",
    )
}

rule include_compiler_directive {
    seq(
        dsl::directive("include"),
        choice(
            double_quoted_string,
            include_compiler_directive_standard,
        ),
    )
}

// 22-2 `define

rule default_text { regexp(r"\w+") }

rule macro_text { regexp(r"(\\(.|\r?\n)|[^\\\n])*") }

rule text_macro_name {
    seq(
        text_macro_identifier,
        dsl::optseq(["(", list_of_formal_arguments, ")"]),
    )
}

rule list_of_formal_arguments { dsl::sep1(",", formal_argument) }

rule formal_argument {
    seq(
        simple_identifier,
        dsl::optseq(["=", default_text]),
    )
}

rule text_macro_identifier { _identifier }

// 22-5 define

rule text_macro_definition {
    seq(
        dsl::directive("define"),
        text_macro_name,
        optional(macro_text),
        "\n",
    )
}

// 22-3 usage

rule text_macro_usage {
    seq(
        "`",
        text_macro_identifier,
        dsl::optseq(["(", list_of_actual_arguments, ")"]),
    )
}

rule simple_text_macro_usage {
    seq(
        "`",
        text_macro_identifier,
    )
}

// 22-4 22-5

rule id_directive {
    seq(
        choice(
            dsl::directive("ifdef"),
            dsl::directive("ifndef"),
            dsl::directive("elsif"),
            dsl::directive("undef"), // 22-5-2
        ),
        text_macro_identifier,
    )
}

rule zero_directive {
    choice(
        dsl::directive("resetall"), // 22-3
        dsl::directive("undefineall"), // 22-5-3
        dsl::directive("endif"),
        dsl::directive("else"),
        dsl::directive("nounconnected_drive"),
        dsl::directive("celldefine"), // 22-10
        dsl::directive("endcelldefine"),
        dsl::directive("end_keywords"), // 22.14
    )
}

// 22-7 timescale

rule timescale_compiler_directive {
    seq(
        dsl::directive("timescale"),
        time_literal, // time_unit,
        "/",
        time_literal, // time_precision
        "\n",
    )
}

// 22-8 default_nettype

rule default_nettype_compiler_directive {
    seq(
        dsl::directive("default_nettype"),
        default_nettype_value,
        "\n",
    )
}

rule default_nettype_value { choice("wire", "tri", "tri0", "tri1", "wand", "triand", "wor", "trior", "trireg", "uwire", "none") }

// 22-9

rule unconnected_drive {
    seq(
        dsl::directive("unconnected_drive"),
        choice("pull0", "pull1"),
        "\n",
    )
}

// 22-12

rule line_compiler_directive {
    seq(
        dsl::directive("line"),
        unsigned_number,
        double_quoted_string,
        unsigned_number,
        "\n",
    )
}

// 22.13
// `__FILE__ and `__LINE__

// 22.14

rule begin_keywords {
    seq(
        dsl::directive("begin_keywords"),
        double_quoted_string,
    )
}

rule _directives {
    choice(
        line_compiler_directive,
        include_compiler_directive,
        text_macro_definition,
        text_macro_usage,
        id_directive,
        zero_directive,
        timescale_compiler_directive,
        default_nettype_compiler_directive,
        unconnected_drive,
        begin_keywords,
    )
}

// TODO missing arguments, empty list of arguments

rule list_of_actual_arguments { dsl::sep1(",", _actual_argument) }

rule _actual_argument { expression }
