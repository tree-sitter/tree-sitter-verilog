// A.1 Source text and top-level items.

let dsl = import("helpers.tsg")

expect _any_parameter_declaration
expect _assertion_item
expect _assertion_item_declaration
expect _conditional_generate_construct
expect _directives
expect _identifier
expect _module_identifier
expect _property_actual_arg
expect _variable_dimension
expect _variable_port_type
expect always_construct
expect attribute_instance
expect block_item_declaration
expect cell_identifier
expect checker_identifier
expect checker_instantiation
expect class_identifier
expect class_scope
expect class_type
expect clocking_declaration
expect clocking_identifier
expect concurrent_assertion_item
expect config_identifier
expect const_identifier
expect constant_bit_select1
expect constant_expression
expect constant_select1
expect constraint_identifier
expect continuous_assign
expect covergroup_declaration
expect data_declaration
expect data_type
expect dpi_import_export
expect expression
expect expression_or_dist
expect final_construct
expect formal_port_identifier
expect function_declaration
expect function_prototype
expect function_statement_or_null
expect gate_instantiation
expect generate_region
expect genvar_declaration
expect hierarchical_identifier
expect implicit_class_handle
expect initial_construct
expect inout_declaration
expect input_declaration
expect instance_identifier
expect interface_identifier
expect interface_instantiation
expect interface_port_declaration
expect library_identifier
expect lifetime
expect line_compiler_directive
expect list_of_arguments
expect list_of_arguments_parent
expect list_of_defparam_assignments
expect list_of_param_assignments
expect list_of_type_assignments
expect local_parameter_declaration
expect loop_generate_construct
expect loop_variables1
expect modport_declaration
expect modport_identifier
expect module_instantiation
expect named_parameter_assignment
expect net_alias
expect net_declaration
expect net_port_type1
expect open_range_list
expect output_declaration
expect overload_declaration
expect package_export_declaration
expect package_identifier
expect package_import_declaration
expect parameter_value_assignment
expect port_identifier
expect program_identifier
expect program_instantiation
expect property_formal_type1
expect ps_class_identifier
expect ps_or_hierarchical_array_identifier
expect ref_declaration
expect select1
expect specify_block
expect specparam_declaration
expect task_declaration
expect task_prototype
expect tf_port_list
expect time_literal
expect topmodule_identifier
expect type_declaration
expect udp_declaration
expect udp_instantiation
expect unpacked_dimension
expect value_range

// A.1.1 Library source text

// library_text: $ => repeat($.library_description),

// library_description: $ => choice(
//   $.library_declaration,
//   $.include_statement,
//   $.config_declaration,
//   ';'
// ),
//
// library_declaration: $ => seq(
//   'library',
//   $.library_identifier,
//   sep1(',', $.file_path_spec),
//   optseq('-incdir', sep1(',', $.file_path_spec)),
//   ';'
// ),
//
// include_statement: $ => seq('include', $.file_path_spec, ';'),

// A.1.2 SystemVerilog source text

rule _description {
    choice(
        _directives,
        module_declaration,
        udp_declaration,
        interface_declaration,
        program_declaration,
        package_declaration,
        seq(repeat(attribute_instance), _package_item),
        seq(repeat(attribute_instance), bind_directive),
        // $.config_declaration,
    )
}

// module_nonansi_header: $ =>
//   { attribute_instance } module_keyword [ lifetime ] _module_identifier
//     { package_import_declaration } [ parameter_port_list ] list_of_ports ';'
//
// module_ansi_header: $ =>
//   { attribute_instance } module_keyword [ lifetime ] _module_identifier
//     { package_import_declaration } [ parameter_port_list ] [ list_of_port_declarations ] ';'
//
// module_declaration: $ =>
//   module_nonansi_header [ timeunits_declaration ] { module_item }
//     'endmodule' [ ':' _module_identifier ]
// | module_ansi_header [ timeunits_declaration ] { non_port_module_item }
//     'endmodule' [ ':' _module_identifier ]
// | { attribute_instance } module_keyword [ lifetime ] _module_identifier '(' '.*' ')' ';'
//   [ timeunits_declaration ] { module_item } 'endmodule' [ ':' _module_identifier ]
// | 'extern' module_nonansi_header
// | 'extern' module_ansi_header

rule module_header {
    seq(
        repeat(attribute_instance),
        module_keyword,
        optional(lifetime),
        _module_identifier,
    )
}

rule module_nonansi_header {
    seq(
        repeat(package_import_declaration),
        optional(parameter_port_list),
        list_of_ports,
    )
}

rule module_ansi_header {
    seq(
        repeat(package_import_declaration),
        choice(
            seq(parameter_port_list, optional(list_of_port_declarations)),
            list_of_port_declarations,
        ),
    )
}

rule module_declaration {
    choice(
        seq(
            module_header,
            optional(choice(
                module_nonansi_header,
                module_ansi_header,
                seq("(", ".*", ")"),
            )),
            ";",
            optional(timeunits_declaration),
            repeat(_module_item),
            "endmodule", dsl::optseq([":", _module_identifier]),
        ),
        seq("extern", module_header, choice(
            module_nonansi_header,
            module_ansi_header,
        )),
    )
}

rule module_keyword { choice("module", "macromodule") }

rule interface_declaration {
    choice(
        seq(
            interface_nonansi_header,
            optional(timeunits_declaration),
            repeat(interface_item),
            "endinterface", dsl::optseq([":", interface_identifier]),
        ),
        seq(
            interface_ansi_header,
            optional(timeunits_declaration),
            repeat(_non_port_interface_item),
            "endinterface", dsl::optseq([":", interface_identifier]),
        ),
        seq(
            repeat(attribute_instance),
            "interface",
            interface_identifier,
            "(", ".*", ")", ";",
            optional(timeunits_declaration),
            repeat(interface_item),
            "endinterface", dsl::optseq([":", interface_identifier]),
        ),
        seq("extern", interface_nonansi_header),
        seq("extern", interface_ansi_header),
    )
}

rule interface_nonansi_header {
    seq(
        repeat(attribute_instance),
        "interface",
        optional(lifetime),
        interface_identifier,
        repeat(package_import_declaration),
        optional(parameter_port_list),
        list_of_ports,
        ";",
    )
}

rule interface_ansi_header {
    seq(
        repeat(attribute_instance),
        "interface",
        optional(lifetime),
        interface_identifier,
        repeat(package_import_declaration),
        optional(parameter_port_list),
        optional(list_of_port_declarations),
        ";",
    )
}

rule program_declaration {
    choice(
        seq(
            program_nonansi_header,
            optional(timeunits_declaration),
            repeat(program_item),
            "endprogram", dsl::optseq([":", program_identifier]),
        ),
        seq(
            program_ansi_header,
            optional(timeunits_declaration),
            repeat(non_port_program_item),
            "endprogram", dsl::optseq([":", program_identifier]),
        ),
        seq(
            repeat(attribute_instance),
            "program",
            program_identifier,
            "(", ".*", ")", ";",
            optional(timeunits_declaration),
            repeat(program_item),
            "endprogram", dsl::optseq([":", program_identifier]),
        ),
        seq("extern", program_nonansi_header),
        seq("extern", program_ansi_header),
    )
}

rule program_nonansi_header {
    seq(
        repeat(attribute_instance),
        "program",
        optional(lifetime),
        program_identifier,
        repeat(package_import_declaration),
        optional(parameter_port_list),
        list_of_ports,
        ";",
    )
}

rule program_ansi_header {
    seq(
        repeat(attribute_instance),
        "program",
        optional(lifetime),
        program_identifier,
        repeat(package_import_declaration),
        optional(parameter_port_list),
        optional(list_of_port_declarations),
        ";",
    )
}

rule checker_declaration {
    seq(
        "checker",
        checker_identifier,
        dsl::optseq(["(", optional(checker_port_list), ")"]),
        ";",
        dsl::repseq(
            [repeat(attribute_instance),
            _checker_or_generate_item],
        ),
        "endchecker", dsl::optseq([":", checker_identifier]),
    )
}

rule class_declaration {
    seq(
        optional("virtual"),
        "class",
        optional(lifetime),
        class_identifier,
        optional(parameter_port_list),
        dsl::optseq(
            ["extends", class_type, optional(list_of_arguments_parent)],
        ),
        dsl::optseq(
            ["implements", dsl::sep1(",", interface_class_type)],
        ),
        ";",
        repeat(class_item),
        "endclass", dsl::optseq([":", class_identifier]),
    )
}

rule interface_class_type {
    seq(
        ps_class_identifier,
        optional(parameter_value_assignment),
    )
}

rule interface_class_declaration {
    seq(
        "interface", "class",
        class_identifier,
        optional(parameter_port_list),
        dsl::optseq(
            ["extends", optional(dsl::sep1(",", interface_class_type)), ";"],
        ),
        repeat(interface_class_item),
        "endclass", dsl::optseq([":", class_identifier]),
    )
}

rule interface_class_item {
    choice(
        type_declaration,
        seq(repeat(attribute_instance), interface_class_method),
        seq(_any_parameter_declaration, ";"),
        ";",
    )
}

rule interface_class_method { seq("pure", "virtual", _method_prototype, ";") }

rule package_declaration {
    seq(
        repeat(attribute_instance),
        "package", optional(lifetime), package_identifier, ";",
        optional(timeunits_declaration),
        dsl::repseq([repeat(attribute_instance), _package_item]),
        "endpackage", dsl::optseq([":", package_identifier]),
    )
}

rule timeunits_declaration {
    choice(
        prec_left(0, seq("timeunit", time_literal, dsl::optseq(["/", time_literal]), ";")),
        prec_left(0, seq("timeprecision", time_literal, ";")),
        prec_left(0, seq("timeunit", time_literal, ";", "timeprecision", time_literal, ";")),
        prec_left(0, seq("timeprecision", time_literal, ";", "timeunit", time_literal, ";")),
    )
}

// A.1.3 Module parameters and ports

rule parameter_port_list {
    seq(
        "#", "(",
        optional(choice(
            seq(list_of_param_assignments, dsl::repseq([",", parameter_port_declaration])),
            dsl::sep1(",", parameter_port_declaration),
        )),
        ")",
    )
}

rule parameter_port_declaration {
    choice(
        _any_parameter_declaration,
        seq(data_type, list_of_param_assignments),
        seq("type", list_of_type_assignments),
    )
}

rule list_of_ports {
    seq(
        "(",
        optional(dsl::sep1(",", seq(
            optional(line_compiler_directive),
            port,
            optional(line_compiler_directive),
        ))),
        ")",
    )
}

rule list_of_port_declarations {
    seq(
        "(",
        optional(dsl::sep1(",", seq(
            repeat(attribute_instance),
            ansi_port_declaration,
        ))),
        ")",
    )
}

rule port_declaration {
    seq(
        repeat(attribute_instance),
        choice(
            inout_declaration,
            input_declaration,
            output_declaration,
            ref_declaration,
            interface_port_declaration,
        ),
    )
}

rule port {
    choice(
        _port_expression,
        seq(".", port_identifier, "(", optional(_port_expression), ")"),
    )
}

rule _port_expression {
    choice(
        port_reference,
        seq("{", dsl::sep1(",", port_reference), "}"),
    )
}

rule port_reference {
    seq(
        port_identifier,
        optional(constant_select1),
    )
}

rule port_direction { choice("input", "output", "inout", "ref") }

rule net_port_header1 {
    choice(
        seq(optional(port_direction), net_port_type1),
        port_direction,
    )
}

rule variable_port_header {
    seq(
        optional(port_direction),
        _variable_port_type,
    )
}

rule interface_port_header {
    seq(
        choice(
            interface_identifier,
            "interface",
        ),
        dsl::optseq([".", modport_identifier]),
    )
}

rule ansi_port_declaration {
    choice(
        seq(
            optional(choice(net_port_header1, interface_port_header)),
            port_identifier,
            repeat(unpacked_dimension),
            dsl::optseq(["=", constant_expression]),
        ),
        seq(
            optional(variable_port_header),
            port_identifier,
            repeat(_variable_dimension),
            dsl::optseq(["=", constant_expression]),
        ),
        seq(
            optional(port_direction), ".", port_identifier,
            "(", optional(expression), ")",
        ),
    )
}

// A.1.4 Module items

rule elaboration_system_task {
    choice(
        seq(
            "$fatal",
            dsl::optseq(
                ["(", finish_number, dsl::optseq([",", list_of_arguments]), ")"],
            ),
            ";",
        ),
        seq(
            choice("$error", "$warning", "$info"),
            optional(list_of_arguments_parent),
            ";",
        ),
    )
}

rule finish_number { choice("0", "1", "2") }

rule _module_common_item {
    choice(
        _module_or_generate_item_declaration,
        interface_instantiation,
        program_instantiation,
        _assertion_item,
        bind_directive,
        continuous_assign,
        net_alias,
        initial_construct,
        final_construct,
        always_construct,
        loop_generate_construct,
        _conditional_generate_construct,
        elaboration_system_task,
    )
}

rule _module_item {
    choice(
        seq(port_declaration, ";"),
        _non_port_module_item,
    )
}

rule module_or_generate_item {
    seq(
        repeat(attribute_instance),
        choice(
            parameter_override,
            gate_instantiation,
            udp_instantiation,
            module_instantiation,
            _module_common_item,
        ),
    )
}

rule _module_or_generate_item_declaration {
    choice(
        package_or_generate_item_declaration,
        genvar_declaration,
        clocking_declaration,
        seq("default", "clocking", clocking_identifier, ";"),
        seq("default", "disable", "iff", expression_or_dist, ";"),
    )
}

rule _non_port_module_item {
    choice(
        _directives,
        generate_region,
        module_or_generate_item,
        specify_block,
        seq(repeat(attribute_instance), specparam_declaration),
        program_declaration,
        module_declaration,
        interface_declaration,
        timeunits_declaration,
    )
}

rule parameter_override {
    seq(
        "defparam",
        list_of_defparam_assignments,
        ";",
    )
}

rule bind_directive {
    seq(
        "bind",
        choice(
            seq(
                bind_target_scope,
                dsl::optseq([":", bind_target_instance_list]),
            ),
            bind_target_instance,
        ),
        _bind_instantiation,
        ";",
    )
}

rule bind_target_scope {
    choice(
        _module_identifier,
        // $.interface_identifier
    )
}

rule bind_target_instance {
    seq(
        hierarchical_identifier,
        optional(constant_bit_select1),
    )
}

rule bind_target_instance_list { dsl::sep1(",", bind_target_instance) }

rule _bind_instantiation {
    choice(
        program_instantiation,
        module_instantiation,
        interface_instantiation,
        checker_instantiation,
    )
}

// A.1.5 Configuration source text

rule config_declaration {
    seq(
        "config", config_identifier, ";",
        dsl::repseq([local_parameter_declaration, ";"]),
        design_statement,
        repeat(config_rule_statement),
        "endconfig", dsl::optseq([":", config_identifier]),
    )
}

rule design_statement {
    seq(
        "design",
        dsl::repseq(
            [dsl::optseq([library_identifier, "."]),
            cell_identifier],
        ),
        ";",
    )
}

rule config_rule_statement {
    choice(
        seq(default_clause, liblist_clause, ";"),
        seq(inst_clause, liblist_clause, ";"),
        seq(inst_clause, use_clause, ";"),
        seq(cell_clause, liblist_clause, ";"),
        seq(cell_clause, use_clause, ";"),
    )
}

rule default_clause { "default" }

rule inst_clause { seq("instance", inst_name) }

rule inst_name { seq(topmodule_identifier, dsl::repseq([".", instance_identifier])) }

rule cell_clause { seq("cell", dsl::optseq([library_identifier, "."]), cell_identifier) }

rule liblist_clause { seq("liblist", repeat(library_identifier)) }

rule use_clause {
    seq(
        "use",
        choice(
            dsl::sep1(",", named_parameter_assignment),
            seq(
                dsl::optseq([library_identifier, "."]),
                cell_identifier,
                optional(dsl::sep1(",", named_parameter_assignment)),
            ),
        ),
        dsl::optseq([":", "config"]),
    )
}

// A.1.6 Interface items

rule interface_or_generate_item {
    choice(
        seq(repeat(attribute_instance), _module_common_item),
        seq(repeat(attribute_instance), extern_tf_declaration),
    )
}

rule extern_tf_declaration {
    choice(
        seq("extern", _method_prototype, ";"),
        seq("extern", "forkjoin", task_prototype, ";"),
    )
}

rule interface_item {
    choice(
        seq(port_declaration, ";"),
        _non_port_interface_item,
    )
}

rule _non_port_interface_item {
    choice(
        generate_region,
        interface_or_generate_item,
        program_declaration,
        modport_declaration,
        interface_declaration,
        timeunits_declaration,
    )
}

// A.1.7 Program items

rule program_item {
    choice(
        seq(port_declaration, ";"),
        non_port_program_item,
    )
}

rule non_port_program_item {
    choice(
        seq(repeat(attribute_instance), continuous_assign),
        seq(repeat(attribute_instance), _module_or_generate_item_declaration),
        seq(repeat(attribute_instance), initial_construct),
        seq(repeat(attribute_instance), final_construct),
        seq(repeat(attribute_instance), concurrent_assertion_item),
        timeunits_declaration,
        _program_generate_item,
    )
}

rule _program_generate_item {
    choice(
        loop_generate_construct,
        _conditional_generate_construct,
        generate_region,
        elaboration_system_task,
    )
}

// A.1.8 Checker items

rule checker_port_list { dsl::sep1(",", checker_port_item) }

rule checker_port_item {
    seq(
        repeat(attribute_instance),
        optional(checker_port_direction),
        optional(property_formal_type1),
        formal_port_identifier,
        repeat(_variable_dimension),
        dsl::optseq(["=", _property_actual_arg]),
    )
}

rule checker_port_direction { choice("input", "output") }

rule _checker_or_generate_item {
    choice(
        checker_or_generate_item_declaration,
        initial_construct,
        always_construct,
        final_construct,
        _assertion_item,
        continuous_assign,
        _checker_generate_item,
    )
}

rule checker_or_generate_item_declaration {
    choice(
        seq(optional("rand"), data_declaration),
        function_declaration,
        checker_declaration,
        _assertion_item_declaration,
        covergroup_declaration,
        genvar_declaration,
        clocking_declaration,
        seq("default", "clocking", clocking_identifier, ";"),
        prec_right(dsl::PREC.iff, seq("default", "disable", "iff", expression_or_dist, ";")),
        ";",
    )
}

rule _checker_generate_item {
    choice(
        loop_generate_construct,
        _conditional_generate_construct,
        generate_region,
        elaboration_system_task,
    )
}

// A.1.9 Class items

rule class_item {
    choice(
        _directives,
        seq(repeat(attribute_instance), class_property),
        seq(repeat(attribute_instance), class_method),
        seq(repeat(attribute_instance), _class_constraint),
        seq(repeat(attribute_instance), class_declaration),
        seq(repeat(attribute_instance), covergroup_declaration),
        seq(_any_parameter_declaration, ";"),
        ";",
    )
}

rule class_property {
    choice(
        seq(repeat(_property_qualifier), data_declaration),
        seq(
            "const",
            repeat(class_item_qualifier),
            data_type,
            const_identifier,
            dsl::optseq(["=", constant_expression]),
            ";",
        ),
    )
}

rule class_method {
    choice(
        seq(repeat(method_qualifier), task_declaration),
        seq(repeat(method_qualifier), function_declaration),
        seq("pure", "virtual", repeat(class_item_qualifier), _method_prototype, ";"),
        seq("extern", repeat(method_qualifier), _method_prototype, ";"),
        seq(repeat(method_qualifier), class_constructor_declaration),
        seq("extern", repeat(method_qualifier), class_constructor_prototype),
    )
}

rule class_constructor_prototype {
    seq(
        "function", "new", dsl::optseq(["(", optional(tf_port_list), ")"]), ";",
    )
}

rule _class_constraint {
    choice(
        constraint_prototype,
        constraint_declaration,
    )
}

rule class_item_qualifier { choice("static", "protected", "local") }

rule _property_qualifier {
    choice(
        random_qualifier,
        class_item_qualifier,
    )
}

rule random_qualifier { choice("rand", "randc") }

rule method_qualifier {
    choice(
        seq(optional("pure"), "virtual"),
        class_item_qualifier,
    )
}

rule _method_prototype {
    choice(
        task_prototype,
        function_prototype,
    )
}

rule class_constructor_declaration {
    seq(
        "function",
        optional(class_scope),
        "new",
        dsl::optseq(["(", optional(tf_port_list), ")"]),
        ";",
        repeat(block_item_declaration),
        dsl::optseq(
            ["super", ".", "new",
            optional(list_of_arguments_parent),
            ";"],
        ),
        repeat(function_statement_or_null),
        "endfunction", dsl::optseq([":", "new"]),
    )
}

// A.1.10 Constraints

rule constraint_declaration {
    seq(
        optional("static"),
        "constraint",
        constraint_identifier,
        constraint_block,
    )
}

rule constraint_block { seq("{", repeat(constraint_block_item), "}") }

rule constraint_block_item {
    choice(
        seq("solve", solve_before_list, "before", solve_before_list, ";"),
        constraint_expression,
    )
}

rule solve_before_list { dsl::sep1(",", constraint_primary) }

rule constraint_primary {
    seq(
        optional(choice(
            seq(implicit_class_handle, "."),
            class_scope,
        )),
        hierarchical_identifier,
        optional(select1),
    )
}

rule constraint_expression {
    choice(
        seq(optional("soft"), expression_or_dist, ";"),
        seq(uniqueness_constraint, ";"),
        prec_right(dsl::PREC.IMPLICATION, seq(expression, "–>", constraint_set)),
        prec_left(0, seq(
            "if", "(", expression, ")", constraint_set,
            dsl::optseq(["else", constraint_set]),
        )),
        seq(
            "foreach", "(",
            ps_or_hierarchical_array_identifier,
            "[", optional(loop_variables1), "]",
            ")",
            constraint_set,
        ),
        seq("disable", "soft", constraint_primary, ";"),
    )
}

rule uniqueness_constraint {
    seq(
        "unique", "{", open_range_list, "}",
    )
}

rule constraint_set {
    choice(
        constraint_expression,
        seq("{", repeat(constraint_expression), "}"),
    )
}

rule dist_list { dsl::sep1(",", dist_item) }

rule dist_item { seq(value_range, optional(dist_weight)) }

rule dist_weight { seq(choice(":=", ":/"), expression) }

rule constraint_prototype {
    seq(
        optional(constraint_prototype_qualifier),
        optional("static"),
        "constraint",
        constraint_identifier,
        ";",
    )
}

rule constraint_prototype_qualifier { choice("extern", "pure") }

rule extern_constraint_declaration {
    seq(
        optional("static"),
        "constraint",
        class_scope,
        constraint_identifier,
        constraint_block,
    )
}

rule identifier_list { dsl::sep1(",", _identifier) }

// A.1.11 Package items

rule _package_item {
    choice(
        package_or_generate_item_declaration,
        anonymous_program,
        package_export_declaration,
        timeunits_declaration,
    )
}

rule package_or_generate_item_declaration {
    choice(
        net_declaration,
        data_declaration,
        task_declaration,
        function_declaration,
        checker_declaration,
        dpi_import_export,
        extern_constraint_declaration,
        class_declaration,
        interface_class_declaration, // not in spec
        class_constructor_declaration,
        seq(_any_parameter_declaration, ";"),
        covergroup_declaration,
        overload_declaration,
        _assertion_item_declaration,
        ";",
    )
}

rule anonymous_program {
    seq(
        "program", ";", repeat(anonymous_program_item), "endprogram",
    )
}

rule anonymous_program_item {
    choice(
        task_declaration,
        function_declaration,
        class_declaration,
        covergroup_declaration,
        class_constructor_declaration,
        ";",
    )
}
