// named_checker_port_connection: $ => choice(
//   seq(
//     repeat($.attribute_instance), '.', $.formal_port_identifier,
//     optseq('(', optional($._property_actual_arg), ')')
//   ),
//   seq(
//     repeat($.attribute_instance, '.*')
//   )
