// A.4 Generated and module/interface instantiations.

let dsl = import("helpers.tsg")

expect _checker_or_generate_item
expect _genvar_expression
expect _module_identifier
expect _property_actual_arg
expect assignment_operator
expect attribute_instance
expect constant_expression
expect expression
expect formal_port_identifier
expect generate_block_identifier
expect genvar_identifier
expect inc_or_dec_operator
expect instance_identifier
expect interface_identifier
expect interface_or_generate_item
expect module_or_generate_item
expect param_expression
expect parameter_identifier
expect port_identifier
expect program_identifier
expect ps_checker_identifier
expect unpacked_dimension

// A.4 Instantiations

// A.4.1 Instantiation

// A.4.1.1 Module instantiation

rule module_instantiation {
    seq(
        _module_identifier,
        optional(parameter_value_assignment),
        dsl::sep1(",", hierarchical_instance),
        ";",
    )
}

rule parameter_value_assignment {
    seq(
        "#", "(", optional(list_of_parameter_assignments), ")",
    )
}

rule list_of_parameter_assignments {
    choice(
        dsl::sep1(",", ordered_parameter_assignment),
        dsl::sep1(",", named_parameter_assignment),
    )
}

rule ordered_parameter_assignment { alias(param_expression, _ordered_parameter_assignment) }

rule named_parameter_assignment {
    seq(
        ".", parameter_identifier, "(", optional(param_expression), ")",
    )
}

rule hierarchical_instance {
    seq(
        name_of_instance, "(", optional(list_of_port_connections), ")",
    )
}

rule name_of_instance {
    seq(
        instance_identifier, repeat(unpacked_dimension),
    )
}

// Reordered

rule list_of_port_connections {
    choice(
        dsl::sep1(",", named_port_connection),
        dsl::sep1(",", ordered_port_connection),
    )
}

rule ordered_port_connection {
    seq(
        repeat(attribute_instance),
        expression,
    )
}

// from spec:
// named_port_connection: $ =>
//   { attribute_instance } . port_identifier [ ( [ expression ] ) ]
// | { attribute_instance } .*

rule named_port_connection {
    seq(
        repeat(attribute_instance),
        choice(
            seq(".", port_identifier, dsl::optseq(
                ["(", optional(expression), ")"],
            )),
            ".*",
        ),
    )
}

// A.4.1.2 Interface instantiation

rule interface_instantiation {
    seq(
        interface_identifier,
        optional(parameter_value_assignment),
        dsl::sep1(",", hierarchical_instance),
        ";",
    )
}

// A.4.1.3 Program instantiation

rule program_instantiation {
    seq(
        program_identifier,
        optional(parameter_value_assignment),
        dsl::sep1(",", hierarchical_instance),
        ";",
    )
}

// A.4.1.4 Checker instantiation

rule checker_instantiation {
    seq(
        ps_checker_identifier,
        name_of_instance,
        "(",
        // optional($.list_of_checker_port_connections),
        choice(
            dsl::sep1(",", dsl::optseq(
                [repeat(attribute_instance),
                optional(_property_actual_arg)],
            )),
            // sep1(',', $.named_checker_port_connection)
            dsl::sep1(",", choice(
                seq(
                    repeat(attribute_instance), ".", formal_port_identifier,
                    dsl::optseq(["(", optional(_property_actual_arg), ")"]),
                ),
                seq(
                    repeat(attribute_instance), ".*",
                ),
            )),
        ),
        ")",
        ";",
    )
}

