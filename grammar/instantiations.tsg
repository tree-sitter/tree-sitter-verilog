// A.4.2 Generated instantiation

rule generate_region {
    seq(
        "generate", repeat(_generate_item), "endgenerate",
    )
}

rule loop_generate_construct {
    seq(
        "for", "(",
        genvar_initialization, ";", _genvar_expression, ";", genvar_iteration,
        ")",
        generate_block,
    )
}

rule genvar_initialization {
    seq(
        optional("genvar"),
        genvar_identifier,
        "=",
        constant_expression,
    )
}

rule genvar_iteration {
    choice(
        seq(genvar_identifier, assignment_operator, _genvar_expression),
        seq(inc_or_dec_operator, genvar_identifier),
        seq(genvar_identifier, inc_or_dec_operator),
    )
}

rule _conditional_generate_construct {
    choice(
        if_generate_construct,
        case_generate_construct,
    )
}

rule if_generate_construct {
    prec_left(0, seq(
        "if", "(", constant_expression, ")", generate_block,
        dsl::optseq(["else", generate_block]),
    ))
}

rule case_generate_construct {
    seq(
        "case", "(", constant_expression, ")", case_generate_item,
        repeat(case_generate_item),
        "endcase",
    )
}

rule case_generate_item {
    choice(
        seq(dsl::sep1(",", constant_expression), ":", generate_block),
        seq("default", optional(":"), generate_block),
    )
}

rule generate_block {
    choice(
        _generate_item,
        seq(
            dsl::optseq([generate_block_identifier, ":"]),
            "begin",
            dsl::optseq([":", generate_block_identifier]),
            repeat(_generate_item),
            "end",
            dsl::optseq([":", generate_block_identifier]),
        ),
    )
}

rule _generate_item {
    choice(
        module_or_generate_item,
        interface_or_generate_item,
        _checker_or_generate_item,
    )
}
