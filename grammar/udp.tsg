// A.5 UDP declarations and instantiations.

expect _udp_identifier
expect _variable_identifier
expect attribute_instance
expect constant_expression
expect delay2
expect drive_strength
expect input_port_identifier
expect input_terminal
expect list_of_udp_port_identifiers
expect name_of_instance
expect output_port_identifier
expect output_terminal
expect port_identifier

rule udp_nonansi_declaration {
    seq(
        repeat(attribute_instance),
        "primitive",
        _udp_identifier,
        "(",
        udp_port_list,
        ")",
        ";",
    )
}

rule udp_ansi_declaration {
    seq(
        repeat(attribute_instance),
        "primitive",
        _udp_identifier,
        "(",
        udp_declaration_port_list,
        ")",
        ";",
    )
}

rule udp_declaration {
    choice(
        seq(
            udp_nonansi_declaration,
            udp_port_declaration,
            repeat(udp_port_declaration),
            _udp_body,
            "endprimitive",
            choice(
                prec_left(0, seq(
                    ":",
                    _udp_identifier,
                )),
                blank(),
            ),
        ),
        seq(
            udp_ansi_declaration,
            _udp_body,
            "endprimitive",
            choice(
                prec_left(0, seq(
                    ":",
                    _udp_identifier,
                )),
                blank(),
            ),
        ),
        seq(
            "extern",
            udp_nonansi_declaration,
        ),
        seq(
            "extern",
            udp_ansi_declaration,
        ),
        seq(
            repeat(attribute_instance),
            "primitive",
            _udp_identifier,
            "(",
            ".*",
            ")",
            ";",
            repeat(udp_port_declaration),
            _udp_body,
            "endprimitive",
            choice(
                prec_left(0, seq(
                    ":",
                    _udp_identifier,
                )),
                blank(),
            ),
        ),
    )
}

rule udp_port_list {
    seq(
        output_port_identifier,
        ",",
        prec_left(0, seq(
            input_port_identifier,
            repeat(prec_left(0, seq(
                ",",
                input_port_identifier,
            ))),
        )),
    )
}

rule udp_declaration_port_list {
    seq(
        udp_output_declaration,
        ",",
        prec_left(0, seq(
            udp_input_declaration,
            repeat(prec_left(0, seq(
                ",",
                udp_input_declaration,
            ))),
        )),
    )
}

rule udp_port_declaration {
    seq(
        choice(
            udp_output_declaration,
            udp_input_declaration,
            udp_reg_declaration,
        ),
        ";",
    )
}

rule udp_output_declaration {
    seq(
        repeat(attribute_instance),
        "output",
        choice(
            port_identifier,
            seq(
                "reg",
                port_identifier,
                choice(
                    prec_left(0, seq(
                        "=",
                        constant_expression,
                    )),
                    blank(),
                ),
            ),
        ),
    )
}

rule udp_input_declaration {
    seq(
        repeat(attribute_instance),
        "input",
        list_of_udp_port_identifiers,
    )
}

rule udp_reg_declaration {
    seq(
        repeat(attribute_instance),
        "reg",
        _variable_identifier,
    )
}

rule _udp_body {
    choice(
        combinational_body,
        sequential_body,
    )
}

rule combinational_body {
    seq(
        "table",
        repeat1(combinational_entry),
        "endtable",
    )
}

rule combinational_entry {
    seq(
        level_input_list,
        ":",
        output_symbol,
        ";",
    )
}

rule sequential_body {
    seq(
        choice(
            udp_initial_statement,
            blank(),
        ),
        "table",
        repeat1(sequential_entry),
        "endtable",
    )
}

rule udp_initial_statement {
    seq(
        "initial",
        output_port_identifier,
        "=",
        init_val,
        ";",
    )
}

rule init_val {
    choice(
        "1'b0",
        "1'b1",
        "1'bx",
        "1'bX",
        "1'B0",
        "1'B1",
        "1'Bx",
        "1'BX",
        "1",
        "0",
    )
}

rule sequential_entry {
    seq(
        _seq_input_list,
        ":",
        _current_state,
        ":",
        next_state,
        ";",
    )
}

rule _seq_input_list {
    choice(
        level_input_list,
        edge_input_list,
    )
}

rule level_input_list { repeat1(level_symbol) }

rule edge_input_list {
    seq(
        repeat(level_symbol),
        edge_indicator,
        repeat(level_symbol),
    )
}

rule edge_indicator {
    choice(
        seq(
            "(",
            level_symbol,
            level_symbol,
            ")",
        ),
        edge_symbol,
    )
}

rule _current_state { level_symbol }

rule next_state {
    choice(
        output_symbol,
        "-",
    )
}

rule output_symbol { regexp("[01xX]") }

rule level_symbol { regexp("[01xX?bB]") }

rule edge_symbol { regexp("[rRfFpPnN*]") }

rule udp_instantiation {
    seq(
        _udp_identifier,
        choice(
            drive_strength,
            blank(),
        ),
        choice(
            delay2,
            blank(),
        ),
        prec_left(0, seq(
            udp_instance,
            repeat(prec_left(0, seq(
                ",",
                udp_instance,
            ))),
        )),
        ";",
    )
}

rule udp_instance {
    seq(
        choice(
            name_of_instance,
            blank(),
        ),
        "(",
        output_terminal,
        ",",
        prec_left(0, seq(
            input_terminal,
            repeat(prec_left(0, seq(
                ",",
                input_terminal,
            ))),
        )),
        ")",
    )
}
