// A.3 Primitive instances.

let dsl = import("helpers.tsg")

expect delay2
expect delay3
expect drive_strength
expect expression
expect name_of_instance
expect net_lvalue
expect strength0
expect strength1

// A.3 Primitive instances

// A.3.1 Primitive instantiation and instances

rule gate_instantiation {
    seq(
        choice(
            seq(
                cmos_switchtype,
                optional(delay3),
                dsl::sep1(",", cmos_switch_instance),
            ),
            seq(
                enable_gatetype,
                optional(drive_strength), optional(delay3),
                dsl::sep1(",", enable_gate_instance),
            ),
            seq(
                mos_switchtype,
                optional(delay3),
                dsl::sep1(",", mos_switch_instance),
            ),
            seq(
                n_input_gatetype,
                optional(drive_strength), optional(delay2),
                dsl::sep1(",", n_input_gate_instance),
            ),
            seq(
                n_output_gatetype,
                optional(drive_strength), optional(delay2),
                dsl::sep1(",", n_output_gate_instance),
            ),
            seq(
                pass_en_switchtype,
                optional(delay2),
                dsl::sep1(",", pass_enable_switch_instance),
            ),
            seq(
                pass_switchtype,
                dsl::sep1(",", pass_switch_instance),
            ),
            seq(
                "pulldown",
                optional(pulldown_strength),
                dsl::sep1(",", pull_gate_instance),
            ),
            seq(
                "pullup",
                optional(pullup_strength),
                dsl::sep1(",", pull_gate_instance),
            ),
        ),
        ";",
    )
}

rule cmos_switch_instance {
    seq(
        optional(name_of_instance),
        "(",
        output_terminal, ",",
        input_terminal, ",",
        ncontrol_terminal, ",",
        pcontrol_terminal,
        ")",
    )
}

rule enable_gate_instance {
    seq(
        optional(name_of_instance),
        "(", output_terminal, ",", input_terminal, ",", enable_terminal, ")",
    )
}

rule mos_switch_instance {
    seq(
        optional(name_of_instance),
        "(", output_terminal, ",", input_terminal, ",", enable_terminal, ")",
    )
}

rule n_input_gate_instance {
    seq(
        optional(name_of_instance),
        "(", output_terminal, ",", dsl::sep1(",", input_terminal), ")",
    )
}

rule n_output_gate_instance {
    seq(
        optional(name_of_instance),
        "(", dsl::sep1(",", output_terminal), ",", input_terminal, ")",
    )
}

rule pass_switch_instance {
    seq(
        optional(name_of_instance),
        "(", inout_terminal, ",", inout_terminal, ")",
    )
}

rule pass_enable_switch_instance {
    seq(
        optional(name_of_instance),
        "(", inout_terminal, ",", inout_terminal, ",", enable_terminal, ")",
    )
}

rule pull_gate_instance {
    seq(
        optional(name_of_instance),
        "(", output_terminal, ")",
    )
}

// A.3.2 Primitive strengths

rule pulldown_strength {
    choice(
        seq("(", strength0, ",", strength1, ")"),
        seq("(", strength1, ",", strength0, ")"),
        seq("(", strength0, ")"),
    )
}

rule pullup_strength {
    choice(
        seq(",", strength0, ",", strength1, ")"),
        seq(",", strength1, ",", strength0, ")"),
        seq(",", strength1, ")"),
    )
}

// A.3.3 Primitive terminals

rule enable_terminal { expression }

rule inout_terminal { net_lvalue }

rule input_terminal { expression }

rule ncontrol_terminal { expression }

rule output_terminal { net_lvalue }

rule pcontrol_terminal { expression }

// A.3.4 Primitive gate and switch types

rule cmos_switchtype { choice("cmos", "rcmos") }

rule enable_gatetype { choice("bufif0", "bufif1", "notif0", "notif1") }

rule mos_switchtype { choice("nmos", "pmos", "rnmos", "rpmos") }

rule n_input_gatetype { choice("and", "nand", "or", "nor", "xor", "xnor") }

rule n_output_gatetype { choice("buf", "not") }

rule pass_en_switchtype { choice("tranif0", "tranif1", "rtranif1", "rtranif0") }

rule pass_switchtype { choice("tran", "rtran") }
