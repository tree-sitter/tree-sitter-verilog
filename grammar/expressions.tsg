// A.8 Expressions.

let dsl = import("helpers.tsg")

expect _assignment_pattern_expression_type
expect _hierarchical_tf_identifier
expect _hierarchical_variable_identifier
expect _identifier
expect _simple_type
expect assignment_pattern_expression
expect assignment_pattern_net_lvalue
expect assignment_pattern_variable_lvalue
expect attribute_instance
expect casting_type
expect class_scope
expect clocking_event
expect cond_predicate
expect constraint_block
expect data_type
expect hierarchical_identifier
expect identifier_list
expect let_expression
expect member_identifier
expect method_identifier
expect open_range_list
expect operator_assignment
expect package_scope
expect ps_or_hierarchical_net_identifier
expect ps_parameter_identifier
expect sequence_method_call
expect simple_text_macro_usage
expect system_tf_identifier
expect type_reference
expect variable_identifier_list

// A.8 Expressions

// A.8.1 Concatenations

rule concatenation {
    seq(
        "{", dsl::psep1(dsl::PREC.CONCAT, ",", expression), "}",
    )
}

rule constant_concatenation {
    seq(
        "{", dsl::psep1(dsl::PREC.CONCAT, ",", constant_expression), "}",
    )
}

rule constant_multiple_concatenation {
    prec_left(dsl::PREC.CONCAT, seq(
        "{", constant_expression, constant_concatenation, "}",
    ))
}

rule module_path_concatenation {
    seq(
        "{", dsl::psep1(dsl::PREC.CONCAT, ",", module_path_expression), "}",
    )
}

rule module_path_multiple_concatenation {
    prec_left(dsl::PREC.CONCAT, seq(
        "{", constant_expression, module_path_concatenation, "}",
    ))
}

rule multiple_concatenation {
    prec_left(dsl::PREC.CONCAT, seq(
        "{", expression, concatenation, "}",
    ))
}

rule streaming_concatenation {
    prec_left(dsl::PREC.CONCAT, seq(
        "{", stream_operator, optional(slice_size), stream_concatenation, "}",
    ))
}

rule stream_operator { choice(">>", "<<") }

rule slice_size { choice(_simple_type, constant_expression) }

rule stream_concatenation {
    prec_left(dsl::PREC.CONCAT, seq(
        "{", dsl::sep1(",", stream_expression), "}",
    ))
}

rule stream_expression { seq(expression, dsl::optseq(["with", "[", array_range_expression, "]"])) }

rule array_range_expression {
    seq(
        expression,
        optional(choice(
            seq(":", expression),
            seq("+:", expression),
            seq("-:", expression),
        )),
    )
}

rule empty_unpacked_array_concatenation { seq("{", "}") }

// A.8.2 Subroutine calls

rule constant_function_call { function_subroutine_call }

rule tf_call {
    prec_left(0, seq(
        _hierarchical_tf_identifier, // FIXME
        // $.ps_or_hierarchical_tf_identifier,
        repeat(attribute_instance),
        optional(list_of_arguments_parent),
    ))
}

rule system_tf_call {
    prec_left(0, seq(
        system_tf_identifier,
        optional(choice(
            list_of_arguments_parent,
            seq(
                "(",
                choice(
                    seq(data_type, dsl::optseq([",", expression])),
                    prec_left(0, seq(
                        dsl::sep1(",", expression),
                        dsl::optseq([",", optional(clocking_event)]),
                    )),
                ),
                ")",
            ),
        )),
    ))
}

rule subroutine_call {
    choice(
        tf_call,
        system_tf_call,
        method_call,
        seq(dsl::optseq(["std", "::"]), randomize_call),
    )
}

rule function_subroutine_call { subroutine_call }

rule list_of_arguments {
    choice(
        // seq(
        //   sep1(',', optional($.expression)),
        //   repseq(',', '.', $._identifier, '(', optional($.expression), ')')
        // ),
        dsl::sep1(",", seq(".", _identifier, "(", optional(expression), ")")),
    )
}

rule list_of_arguments_parent {
    seq(
        "(",
        choice(
            dsl::sep1(",", expression),
            // sep1(',', optional($.expression)), // FIXME
            seq(
                dsl::repseq([",", ".", _identifier, "(", optional(expression), ")"]),
            ),
            dsl::sep1(",", seq(",", ".", _identifier, "(", optional(expression), ")")),
        ),
        ")",
    )
}

rule method_call { seq(_method_call_root, ".", method_call_body) }

rule method_call_body {
    choice(
        prec_left(0, seq(
            method_identifier,
            repeat(attribute_instance),
            optional(list_of_arguments_parent),
        )),
        _built_in_method_call,
    )
}

rule _built_in_method_call {
    choice(
        array_manipulation_call,
        randomize_call,
    )
}

rule array_manipulation_call {
    prec_left(0, seq(
        array_method_name,
        repeat(attribute_instance),
        optional(list_of_arguments_parent),
        dsl::optseq(["with", "(", expression, ")"]),
    ))
}

rule randomize_call {
    prec_left(0, seq(
        "randomize",
        repeat(attribute_instance),
        dsl::optseq(
            ["(",
            optional(choice(
                variable_identifier_list,
                "null",
            )),
            ")"],
        ),
        dsl::optseq(
            ["with",
            dsl::optseq(
                ["(",
                optional(identifier_list),
                ")"],
            ),
            constraint_block],
        ),
    ))
}

rule _method_call_root { choice(primary, implicit_class_handle) }

rule array_method_name {
    choice(
        method_identifier, "unique", "and", "or", "xor",
    )
}

// A.8.3 Expressions

rule inc_or_dec_expression {
    choice(
        seq(inc_or_dec_operator, repeat(attribute_instance), variable_lvalue),
        seq(variable_lvalue, repeat(attribute_instance), inc_or_dec_operator),
    )
}

rule conditional_expression {
    prec_right(dsl::PREC.CONDITIONAL, seq(
        cond_predicate,
        "?",
        repeat(attribute_instance), expression,
        ":",
        expression,
    ))
}

rule constant_expression {
    choice(
        constant_primary,

        prec_left(dsl::PREC.UNARY, seq(
            unary_operator, repeat(attribute_instance), constant_primary,
        )),

        dsl::binary_operators(constant_expression, attribute_instance),

        prec_right(dsl::PREC.CONDITIONAL, seq(
            constant_expression,
            "?",
            repeat(attribute_instance), constant_expression,
            ":",
            constant_expression,
        )),
    )
}

rule constant_mintypmax_expression {
    seq(
        constant_expression,
        dsl::optseq([":", constant_expression, ":", constant_expression]),
    )
}

rule constant_param_expression {
    choice(
        constant_mintypmax_expression,
        data_type,
        "$",
    )
}

rule param_expression {
    choice(
        mintypmax_expression,
        data_type,
        "$",
    )
}

rule _constant_range_expression {
    choice(
        constant_expression,
        _constant_part_select_range,
    )
}

rule _constant_part_select_range {
    choice(
        constant_range,
        constant_indexed_range,
    )
}

rule constant_range { seq(constant_expression, ":", constant_expression) }

rule constant_indexed_range {
    seq(
        constant_expression, choice("+:", "-:"), constant_expression,
    )
}

rule expression {
    choice(
        primary,

        prec_left(dsl::PREC.UNARY, seq(
            unary_operator, repeat(attribute_instance), primary,
        )),
        prec_left(dsl::PREC.UNARY, inc_or_dec_expression),
        prec_left(dsl::PREC.PARENT, seq("(", operator_assignment, ")")),

        dsl::binary_operators(expression, attribute_instance),

        conditional_expression,
        inside_expression,
        tagged_union_expression,
    )
}

rule tagged_union_expression {
    prec_left(0, seq(
        "tagged",
        member_identifier,
        optional(expression),
    ))
}

rule inside_expression {
    prec_left(dsl::PREC.RELATIONAL, seq(
        expression, "inside", "{", open_range_list, "}",
    ))
}

rule value_range {
    choice(
        expression,
        seq("[", expression, ":", expression, "]"),
    )
}

rule mintypmax_expression {
    seq(
        expression,
        dsl::optseq([":", expression, ":", expression]),
    )
}

rule module_path_conditional_expression {
    seq(
        module_path_expression,
        "?",
        repeat(attribute_instance), module_path_expression,
        ":",
        module_path_expression,
    )
}

rule module_path_expression {
    choice(
        module_path_primary,
        // seq($.unary_module_path_operator, repeat($.attribute_instance), $.module_path_primary),
        // seq(
        //   $.module_path_expression,
        //   $.binary_module_path_operator,
        //   repeat($.attribute_instance),
        //   $.module_path_expression
        // ),
        // $.module_path_conditional_expression
    )
}

rule module_path_mintypmax_expression {
    seq(
        module_path_expression,
        dsl::optseq(
            [":", module_path_expression,
            ":", module_path_expression],
        ),
    )
}

rule _part_select_range {
    choice(
        constant_range,
        indexed_range,
    )
}

rule indexed_range {
    seq(
        expression, choice("+:", "-:"), constant_expression,
    )
}

rule _genvar_expression { constant_expression }

// A.8.4 Primaries


// FIXME FIXME FIXME

rule constant_primary {
    choice(
        primary_literal,
        seq(ps_parameter_identifier, optional(constant_select1)),
        // seq($.specparam_identifier, optseq('[', $._constant_range_expression, ']')),
        // $.genvar_identifier,
        // seq($.formal_port_identifier, optional($.constant_select1)),
        // seq(optional(choice($.package_scope, $.class_scope)), $.enum_identifier),
        seq(constant_concatenation, dsl::optseq(["[", _constant_range_expression, "]"])),
        seq(constant_multiple_concatenation, dsl::optseq(["[", _constant_range_expression, "]"])),
        // $.constant_function_call,
        // $._constant_let_expression,
        seq("(", constant_mintypmax_expression, ")"),
        // $.constant_cast,
        // // $.constant_assignment_pattern_expression,
        type_reference,
        "null",
    )
}

rule module_path_primary {
    choice(
        _number,
        _identifier,
        module_path_concatenation,
        module_path_multiple_concatenation,
        function_subroutine_call,
        seq("(", module_path_mintypmax_expression, ")"),
    )
}

rule primary {
    choice(
        primary_literal,
        seq(
            optional(choice(class_qualifier, package_scope)),
            hierarchical_identifier,
            optional(select1),
        ),
        empty_unpacked_array_concatenation,
        seq(concatenation, dsl::optseq(["[", range_expression, "]"])),
        seq(multiple_concatenation, dsl::optseq(["[", range_expression, "]"])),
        function_subroutine_call,
        let_expression,
        seq("(", mintypmax_expression, ")"),
        cast,
        assignment_pattern_expression,
        streaming_concatenation,
        sequence_method_call,
        "this",
        "$",
        "null",
    )
}

rule class_qualifier {
    seq(
        dsl::optseq(["local", "::"]),
        choice( // TODO optional?
            seq(implicit_class_handle, "."),
            class_scope,
        ),
    )
}

rule range_expression {
    choice(
        expression,
        _part_select_range,
    )
}

//

rule primary_literal {
    choice(
        _number,
        time_literal,
        unbased_unsized_literal,
        string_literal,
        simple_text_macro_usage,
    )
}

rule time_literal {
    choice(
        seq(unsigned_number, time_unit),
        seq(fixed_point_number, time_unit),
    )
}

rule time_unit { choice("s", "ms", "us", "ns", "ps", "fs") }

rule string_literal {
    seq(
        "\"",
        repeat(choice(
            token_immediate(regexp(r#"[^\\"]+"#)),
            // EXTENDS Verilog spec with escape sequences
            token_immediate(seq("\\", regexp(r"."))),
            token_immediate(seq("\\", "\n")),
        )),
        "\"",
    )
}

rule implicit_class_handle {
    choice(
        prec_left(0, seq("this", dsl::optseq([".", "super"]))),
        "super",
    )
}

rule bit_select1 {
    prec_left(dsl::PREC.PARENT, repeat1(seq( // reordered -> non empty
        "[", expression, "]"),
    ))
}

rule select1 {
    choice( // reordered -> non empty
        prec_left(dsl::PREC.PARENT, seq( // 1xx
            dsl::repseq([".", member_identifier, optional(bit_select1)]), ".", member_identifier,
            optional(bit_select1),
            dsl::optseq(["[", _part_select_range, "]"]),
        )),
        prec_left(dsl::PREC.PARENT, seq( // 01x
            //
            bit_select1,
            dsl::optseq(["[", _part_select_range, "]"]),
        )),
        prec_left(dsl::PREC.PARENT, seq( // 001
            //
            //
            seq("[", _part_select_range, "]"),
        )),
    )
}

rule nonrange_select1 {
    choice( // reordered -> non empty
        prec_left(dsl::PREC.PARENT, seq( // 1x
            dsl::repseq([".", member_identifier, optional(bit_select1)]), ".", member_identifier,
            optional(bit_select1),
        )),
        bit_select1,
    )
}

rule constant_bit_select1 {
    repeat1(prec_left(dsl::PREC.PARENT, seq( // reordered -> non empty
        "[", constant_expression, "]",
    )))
}

rule constant_select1 {
    choice( // reordered -> non empty
        seq(
            "[",
            dsl::repseq([constant_expression, "]", "["]),
            choice(constant_expression, _constant_part_select_range),
            "]",
        ),
    )
}

// constant_select1: $ => choice( // reordered -> non empty
//   // seq(
//   //   repseq('.', $.member_identifier, optional($.constant_bit_select1))),
//   //   '.', $.member_identifier,
//   //   optional($.constant_bit_select1),
//   //   optseq('[', $._constant_part_select_range, ']')
//   // ),
//   seq(
//     $.constant_bit_select1,
//     optseq('[', $._constant_part_select_range, ']')
//   ),
//   seq('[', $._constant_part_select_range, ']'),
// ),

rule constant_cast { seq(casting_type, "'", "(", constant_expression, ")") }

rule _constant_let_expression { let_expression }

rule cast { seq(casting_type, "'", "(", expression, ")") }

// A.8.5 Expression left-side values

rule net_lvalue {
    choice(
        seq(
            ps_or_hierarchical_net_identifier,
            optional(constant_select1),
        ),
        prec_left(dsl::PREC.CONCAT, seq("{", dsl::sep1(",", net_lvalue), "}")),
        seq(
            optional(_assignment_pattern_expression_type),
            assignment_pattern_net_lvalue,
        ),
    )
}

rule variable_lvalue {
    choice(
        prec_left(dsl::PREC.PARENT, seq(
            optional(choice(
                seq(implicit_class_handle, "."),
                package_scope,
            )),
            _hierarchical_variable_identifier,
            optional(select1),
        )),
        prec_left(dsl::PREC.CONCAT, seq("{", dsl::sep1(",", variable_lvalue), "}")),
        prec_left(dsl::PREC.ASSIGN, seq(
            optional(_assignment_pattern_expression_type),
            assignment_pattern_variable_lvalue,
        )),
        streaming_concatenation,
    )
}

rule nonrange_variable_lvalue {
    prec_left(dsl::PREC.PARENT, seq(
        optional(choice(
            seq(implicit_class_handle, "."),
            package_scope,
        )),
        _hierarchical_variable_identifier,
        optional(nonrange_select1),
    ))
}

// A.8.6 Operators

rule unary_operator {
    choice(
        "+", "-", "!", "~", "&", "~&", "|", "~|", "^", "~^", "^~",
    )
}

rule inc_or_dec_operator { choice("++", "--") }

// unary_module_path_operator = '~&' /
//   '~|' /
//   '~^' /
//   '^~' /
//   $('!'![ != ]) /
//   $('~'!'=') /
//   $('&'!'=') /
//   $('|'!'=') /
//   $('^'!'=')
//
// binary_module_path_operator = $('=='!'=') /
//   $('!='!'=') /
//   '&&' /
//   '||' /
//   $('&'!'=') /
//   $('|'!'=') /
//   $('^'!'=') /
//   '^~' /
//   '~^'

// A.8.7 Numbers

rule _number { choice(integral_number, real_number) }

rule integral_number {
    choice(
        decimal_number,
        octal_number,
        binary_number,
        hex_number,
    )
}

rule decimal_number {
    choice(
        unsigned_number,
        token(seq(
            dsl::optseq([regexp(r"[1-9][0-9_]*"), regexp(r"\s*")]),
            regexp(r"'[sS]?[dD]"),
            regexp(r"\s*"),
            regexp(r"[0-9][0-9_]*"),
        )),
        token(seq(
            dsl::optseq([regexp(r"[1-9][0-9_]*"), regexp(r"\s*")]),
            regexp(r"'[sS]?[dD]"),
            regexp(r"\s*"),
            regexp(r"[xXzZ?][_]*"),
        )),
    )
}

rule binary_number {
    token(seq(
        dsl::optseq([regexp(r"[1-9][0-9_]*"), regexp(r"\s*")]),
        regexp(r"'[sS]?[bB]"),
        regexp(r"\s*"),
        regexp(r"[01xXzZ?][01xXzZ?_]*"),
    ))
}

rule octal_number {
    token(seq(
        dsl::optseq([regexp(r"[1-9][0-9_]*"), regexp(r"\s*")]),
        regexp(r"'[sS]?[oO]"),
        regexp(r"\s*"),
        regexp(r"[0-7xXzZ?][0-7xXzZ?_]*"),
    ))
}

rule hex_number {
    token(seq(
        dsl::optseq([regexp(r"[1-9][0-9_]*"), regexp(r"\s*")]),
        regexp(r"'[sS]?[hH]"),
        regexp(r"\s*"),
        regexp(r"[0-9a-fA-FxXzZ?][0-9a-fA-FxXzZ?_]*"),
    ))
}

// NOTE: Embedded spaces are illegal.

rule non_zero_unsigned_number { token(regexp(r"[1-9][0-9_]*")) }

rule real_number {
    choice(
        fixed_point_number,
        token(regexp(r"[0-9][0-9_]*(\.[0-9][0-9_]*)?[eE][+-]?[0-9][0-9_]*")),
    )
}

rule fixed_point_number { token(regexp(r"[0-9][0-9_]*\.[0-9][0-9_]*")) }

rule unsigned_number { token(regexp(r"[0-9][0-9_]*")) }

// The apostrophe ( ' ) in unbased_unsized_literal shall not be followed by white_space.

rule unbased_unsized_literal { choice("'0", "'1", regexp(r"'[xXzZ]")) }
