        param_assignment,
        repeat(prec_left(0, seq(
            ",",
            param_assignment,
        ))),
    ))
}

rule list_of_port_identifiers {
    prec_left(0, seq(
        seq(
            port_identifier,
            repeat(unpacked_dimension),
        ),
        repeat(prec_left(0, seq(
            ",",
            seq(
                port_identifier,
                repeat(unpacked_dimension),
            ),
        ))),
    ))
}

rule list_of_udp_port_identifiers {
