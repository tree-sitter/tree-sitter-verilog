}

rule list_of_variable_port_identifiers {
    prec_left(0, seq(
        seq(
            port_identifier,
            repeat(_variable_dimension),
            choice(
                prec_left(0, seq(
                    "=",
                    constant_expression,
                )),
                blank(),
            ),
        ),
        repeat(prec_left(0, seq(
            ",",
            seq(
                port_identifier,
                repeat(_variable_dimension),
                choice(
                    prec_left(0, seq(
                        "=",
                        constant_expression,
                    )),
                    blank(),
                ),
            ),
        ))),
    ))
}

rule defparam_assignment {
    seq(
        _hierarchical_parameter_identifier,
        "=",
        constant_mintypmax_expression,
    )
}

rule net_decl_assignment {
    prec_left(21, seq(
        _net_identifier,
        repeat(unpacked_dimension),
        choice(
            prec_left(0, seq(
                "=",
                expression,
            )),
            blank(),
        ),
    ))
}

rule param_assignment {
    seq(
        parameter_identifier,
        repeat(unpacked_dimension),
        choice(
            prec_left(0, seq(
                "=",
                constant_param_expression,
            )),
            blank(),
        ),
    )
}

rule specparam_assignment {
    choice(
        seq(
            specparam_identifier,
            "=",
            constant_mintypmax_expression,
        ),
        pulse_control_specparam,
    )
}

rule type_assignment {
    seq(
        _type_identifier,
        choice(
            prec_left(0, seq(
                "=",
                data_type,
            )),
            blank(),
        ),
    )
}

rule pulse_control_specparam {
    choice(
        seq(
            "PATHPULSE$=",
            "(",
            reject_limit_value,
            choice(
                prec_left(0, seq(
                    ",",
                    error_limit_value,
                )),
                blank(),
            ),
            ")",
        ),
    )
}

rule error_limit_value { limit_value }

rule reject_limit_value { limit_value }

rule limit_value { constant_mintypmax_expression }

rule variable_decl_assignment {
    choice(
        seq(
            _variable_identifier,
            repeat(_variable_dimension),
            choice(
                prec_left(0, seq(
                    "=",
                    expression,
                )),
                blank(),
            ),
        ),
        seq(
            dynamic_array_variable_identifier,
            unsized_dimension,
            repeat(_variable_dimension),
            choice(
                prec_left(0, seq(
                    "=",
                    dynamic_array_new,
                )),
                blank(),
            ),
        ),
        seq(
            class_variable_identifier,
            choice(
                prec_left(0, seq(
                    "=",
                    class_new,
                )),
                blank(),
            ),
        ),
    )
}

rule class_new {
    choice(
        seq(
            choice(
                class_scope,
                blank(),
            ),
            "new",
            choice(
                list_of_arguments_parent,
                blank(),
            ),
        ),
        seq(
            "new",
            expression,
        ),
    )
}

rule dynamic_array_new {
    seq(
        "new",
        "[",
        expression,
        "]",
        choice(
            prec_left(0, seq(
                "(",
                expression,
                ")",
            )),
            blank(),
        ),
    )
}

rule unpacked_dimension {
    seq(
        "[",
        choice(
            constant_range,
            constant_expression,
        ),
        "]",
    )
}

rule packed_dimension {
    choice(
        seq(
            "[",
            constant_range,
            "]",
        ),
        unsized_dimension,
    )
}

rule associative_dimension {
    seq(
        "[",
        choice(
            data_type,
            "*",
        ),
        "]",
    )
}

rule _variable_dimension {
    choice(
        unsized_dimension,
        unpacked_dimension,
        associative_dimension,
        queue_dimension,
    )
}

rule queue_dimension {
    seq(
        "[",
        "$",
        choice(
            prec_left(0, seq(
                ":",
                constant_expression,
            )),
            blank(),
        ),
        "]",
    )
}

rule unsized_dimension {
    seq(
        "[",
        "]",
    )
}

rule function_data_type_or_implicit1 {
    choice(
        data_type_or_void,
        implicit_data_type1,
    )
}

rule function_declaration {
    seq(
        "function",
        choice(
            lifetime,
            blank(),
        ),
        function_body_declaration,
    )
}

rule function_body_declaration {
    seq(
        choice(
            function_data_type_or_implicit1,
            blank(),
        ),
        choice(
            choice(
                seq(
                    interface_identifier,
                    ".",
                ),
                class_scope,
            ),
            blank(),
        ),
        function_identifier,
        choice(
            seq(
                ";",
                repeat(tf_item_declaration),
            ),
            seq(
                "(",
                choice(
                    tf_port_list,
                    blank(),
                ),
                ")",
                ";",
                repeat(block_item_declaration),
            ),
        ),
        repeat(function_statement_or_null),
        "endfunction",
        choice(
            prec_left(0, seq(
                ":",
                function_identifier,
            )),
            blank(),
        ),
    )
}

rule function_prototype {
    seq(
        "function",
        data_type_or_void,
        function_identifier,
        choice(
            prec_left(0, seq(
                "(",
                choice(
                    tf_port_list,
                    blank(),
                ),
                ")",
            )),
            blank(),
        ),
    )
}

rule dpi_import_export {
    choice(
        seq(
            "import",
            dpi_spec_string,
            choice(
                dpi_function_import_property,
                blank(),
            ),
            choice(
                prec_left(0, seq(
                    c_identifier,
                    "=",
                )),
                blank(),
            ),
            dpi_function_proto,
            ";",
        ),
        seq(
            "import",
            dpi_spec_string,
            choice(
                dpi_task_import_property,
                blank(),
            ),
            choice(
                prec_left(0, seq(
                    c_identifier,
                    "=",
                )),
                blank(),
            ),
            dpi_task_proto,
            ";",
        ),
        seq(
            "export",
            dpi_spec_string,
            choice(
                prec_left(0, seq(
                    c_identifier,
                    "=",
                )),
                blank(),
            ),
            "function",
            function_identifier,
            ";",
        ),
        seq(
            "export",
            dpi_spec_string,
            choice(
                prec_left(0, seq(
                    c_identifier,
                    "=",
                )),
                blank(),
            ),
            "task",
            task_identifier,
            ";",
        ),
    )
}

rule dpi_spec_string {
    choice(
        "\"DPI-C\"",
        "\"DPI\"",
    )
}

rule dpi_function_import_property {
    choice(
        "context",
        "pure",
    )
}

rule dpi_task_import_property { "context" }

rule dpi_function_proto { function_prototype }

rule dpi_task_proto { task_prototype }

rule task_declaration {
    seq(
        "task",
        choice(
            lifetime,
            blank(),
        ),
        task_body_declaration,
    )
}

rule task_body_declaration {
    seq(
        choice(
            choice(
                seq(
                    interface_identifier,
                    ".",
                ),
                class_scope,
            ),
            blank(),
        ),
        task_identifier,
        choice(
            seq(
                ";",
                repeat(tf_item_declaration),
            ),
            seq(
                "(",
                choice(
                    tf_port_list,
                    blank(),
                ),
                ")",
                ";",
                repeat(block_item_declaration),
            ),
        ),
        repeat(statement_or_null),
        "endtask",
        choice(
            prec_left(0, seq(
                ":",
                task_identifier,
            )),
            blank(),
        ),
    )
}

rule tf_item_declaration {
    choice(
        block_item_declaration,
        tf_port_declaration,
    )
}

rule tf_port_list {
    prec_left(0, seq(
        tf_port_item1,
        repeat(prec_left(0, seq(
            ",",
            tf_port_item1,
        ))),
    ))
}

rule tf_port_item1 {
    seq(
        repeat(attribute_instance),
        choice(
            tf_port_direction,
            blank(),
        ),
        choice(
            "var",
            blank(),
        ),
        choice(
            seq(
                data_type_or_implicit1,
                choice(
                    prec_left(0, seq(
                        port_identifier,
                        repeat(_variable_dimension),
                        choice(
                            prec_left(0, seq(
                                "=",
                                expression,
                            )),
                            blank(),
                        ),
                    )),
                    blank(),
                ),
            ),
            seq(
                port_identifier,
                repeat(_variable_dimension),
                choice(
                    prec_left(0, seq(
                        "=",
                        expression,
                    )),
                    blank(),
                ),
            ),
        ),
    )
}

rule tf_port_direction {
