// A.2 Declarations.

let dsl = import("helpers.tsg")

expect _bin_identifier
expect _block_identifier
expect _hierarchical_block_identifier
expect _hierarchical_parameter_identifier
expect _hierarchical_tf_identifier
expect _identifier
expect _method_prototype
expect _net_identifier
expect _net_type_identifier
expect _sequence_identifier
expect _type_identifier
expect _variable_identifier
expect action_block
expect attribute_instance
expect c_identifier
expect checker_instantiation
expect class_identifier
expect class_variable_identifier
expect clocking_event
expect clocking_identifier
expect constant_bit_select1
expect constant_expression
expect constant_mintypmax_expression
expect constant_param_expression
expect constant_primary
expect constant_range
expect cover_point_identifier
expect covergroup_identifier
expect cross_identifier
expect delay_control
expect dist_list
expect dynamic_array_variable_identifier
expect enum_identifier
expect event_expression
expect expression
expect formal_port_identifier
expect function_identifier
expect function_statement_or_null
expect genvar_identifier
expect hierarchical_identifier
expect inc_or_dec_expression
expect integral_number
expect interface_identifier
expect interface_instance_identifier
expect list_of_arguments_parent
expect member_identifier
expect method_identifier
expect mintypmax_expression
expect modport_identifier
expect operator_assignment
expect package_identifier
expect package_scope
expect parameter_identifier
expect parameter_value_assignment
expect port_direction
expect port_identifier
expect property_identifier
expect ps_class_identifier
expect ps_covergroup_identifier
expect ps_identifier
expect ps_or_hierarchical_property_identifier
expect ps_or_hierarchical_sequence_identifier
expect ps_parameter_identifier
expect ps_type_identifier
expect random_qualifier
expect real_number
expect specparam_identifier
expect statement_or_null
expect subroutine_call
expect task_identifier
expect tf_identifier
expect time_literal
expect unsigned_number

// A.2 Declarations

// A.2.1 Declaration types

// A.2.1.1 Module parameter declarations

rule local_parameter_declaration {
    seq(
        "localparam",
        choice(
            seq(
                optional(data_type_or_implicit1),
                list_of_param_assignments,
            ),
            seq("type", list_of_type_assignments),
        ),
    )
}

rule parameter_declaration {
    seq(
        "parameter",
        choice(
            seq(
                optional(data_type_or_implicit1),
                list_of_param_assignments,
            ),
            seq("type", list_of_type_assignments),
        ),
    )
}

rule _any_parameter_declaration {
    choice(
        local_parameter_declaration,
        parameter_declaration,
    )
}

rule specparam_declaration {
    seq(
        "specparam",
        optional(packed_dimension),
        list_of_specparam_assignments,
        ";",
    )
}

// A.2.1.2 Port declarations

rule inout_declaration {
    seq(
        "inout", optional(net_port_type1), list_of_port_identifiers,
    )
}

rule input_declaration {
    seq(
        "input",
        choice(
            seq(optional(net_port_type1), list_of_port_identifiers),
            seq(optional(_variable_port_type), list_of_variable_identifiers),
        ),
    )
}

rule output_declaration {
    seq(
        "output",
        choice(
            seq(optional(net_port_type1), list_of_port_identifiers),
            seq(optional(_variable_port_type), list_of_variable_port_identifiers),
        ),
    )
}

rule interface_port_declaration {
    seq(
        interface_identifier,
        dsl::optseq([".", modport_identifier]),
        list_of_interface_identifiers,
    )
}

rule ref_declaration {
    seq(
        "ref", _variable_port_type, list_of_variable_identifiers,
    )
}

// A.2.1.3 Type declarations

rule data_declaration {
    choice(
        seq(
            optional("const"),
            optional("var"),
            optional(lifetime),
            optional(data_type_or_implicit1),
            list_of_variable_decl_assignments,
            ";",
        ),
        type_declaration,
        package_import_declaration,
        net_type_declaration,
    )
}

rule package_import_declaration {
    seq(
        "import", dsl::sep1(",", package_import_item), ";",
    )
}

rule package_import_item {
    seq(
        package_identifier, "::", choice(_identifier, "*"),
    )
}

rule package_export_declaration {
    seq(
        "export", choice("*::*", dsl::sep1(",", package_import_item)), ";",
    )
}

rule genvar_declaration {
    seq(
        "genvar", list_of_genvar_identifiers, ";",
    )
}

rule net_declaration {
    choice(
        seq(
            net_type,
            optional(choice(drive_strength, charge_strength)),
            optional(choice("vectored", "scalared")),
            optional(data_type_or_implicit1),
            optional(delay3),
            list_of_net_decl_assignments,
            ";",
        ),
        seq(
            _net_type_identifier,
            optional(delay_control),
            list_of_net_decl_assignments,
            ";",
        ),
        seq(
            "interconnect",
            optional(implicit_data_type1),
            dsl::optseq(["#", delay_value]),
            dsl::sep1(",", seq(_net_identifier, repeat(unpacked_dimension))),
            ";",
        ),
    )
}

rule type_declaration {
    seq(
        "typedef",
        choice(
            seq(data_type, _type_identifier, repeat(_variable_dimension)),
            seq(
                interface_instance_identifier, optional(constant_bit_select1),
                ".", _type_identifier, _type_identifier,
            ),
            seq(
                optional(choice(
                    "enum", "struct", "union", "class", seq("interface", "class"),
                )),
                _type_identifier,
            ),
        ),
        ";",
    )
}

rule net_type_declaration {
    seq(
        "nettype",
        choice(
            seq(
                data_type,
                _net_type_identifier,
                dsl::optseq(
                    ["with",
                    optional(choice(package_scope, class_scope)),
                    tf_identifier],
                ),
            ),
            seq(
                optional(choice(package_scope, class_scope)),
                _net_type_identifier,
                _net_type_identifier,
            ),
        ),
        ";",
    )
}

rule lifetime { choice("static", "automatic") }

// A.2.2 Declaration data types

// A.2.2.1 Net and variable types

rule casting_type {
    choice(
        _simple_type,
        constant_primary,
        _signing,
        "string",
        "const",
    )
}

rule data_type {
    choice(
        seq(integer_vector_type, optional(_signing), repeat(packed_dimension)),
        seq(integer_atom_type, optional(_signing)),
        non_integer_type,
        seq(
            struct_union,
            dsl::optseq(["packed", optional(_signing)]),
            "{", repeat1(struct_union_member), "}",
            repeat(packed_dimension),
        ),
        seq(
            "enum", optional(enum_base_type),
            "{", dsl::sep1(",", enum_name_declaration), "}",
            repeat(packed_dimension),
        ),
        "string",
        "chandle",
        prec_left(0, seq(
            "virtual", optional("interface"),
            interface_identifier,
            optional(parameter_value_assignment),
            dsl::optseq([".", modport_identifier]),
        )),
        seq(
            optional(choice(class_scope, package_scope)),
            _type_identifier,
            repeat(packed_dimension),
        ),
        class_type,
        "event",
        ps_covergroup_identifier,
        type_reference,
    )
}

rule data_type_or_implicit1 {
    choice(
        data_type,
        implicit_data_type1,
    )
}

rule implicit_data_type1 {
    choice( // reordered : repeat -> repeat1
        seq(_signing, repeat(packed_dimension)),
        repeat1(packed_dimension),
    )
}

rule enum_base_type {
    choice(
        seq(
            integer_atom_type, optional(_signing),
        ),
        seq(
            integer_vector_type, optional(_signing), optional(packed_dimension),
        ),
        seq(
            _type_identifier, optional(packed_dimension),
        ),
    )
}

rule enum_name_declaration {
    seq(
        enum_identifier,
        dsl::optseq(
            ["[", integral_number, dsl::optseq([":", integral_number]), "]"],
        ),
        dsl::optseq(["=", constant_expression]),
    )
}

rule class_scope { seq(class_type, "::") }

// class_type: $ => prec.left(PREC.PARENT, seq(

rule class_type {
    prec_right(0, seq(
        ps_class_identifier,
        optional(parameter_value_assignment),
        dsl::repseq(
            ["::",
            class_identifier,
            optional(parameter_value_assignment)],
        ),
    ))
}

rule _integer_type {
    choice(
        integer_vector_type,
        integer_atom_type,
    )
}

rule integer_atom_type { choice("byte", "shortint", "int", "longint", "integer", "time") }

rule integer_vector_type { choice("bit", "logic", "reg") }

rule non_integer_type { choice("shortreal", "real", "realtime") }

rule net_type { choice("supply0", "supply1", "tri", "triand", "trior", "trireg", "tri0", "tri1", "uwire", "wire", "wand", "wor") }

rule net_port_type1 {
    choice(
        prec_left(-1, seq(net_type, data_type_or_implicit1)),
        net_type,
        data_type_or_implicit1,

        _net_type_identifier,
        seq("interconnect", optional(implicit_data_type1)),
    )
}

rule _variable_port_type { _var_data_type }

rule _var_data_type {
    prec_left(0, choice(
        data_type,
        seq("var", optional(data_type_or_implicit1)),
    ))
}

rule _signing { choice("signed", "unsigned") }

rule _simple_type {
    choice(
        _integer_type,
        non_integer_type,
        ps_type_identifier,
        ps_parameter_identifier,
    )
}

rule struct_union_member {
    seq(
        repeat(attribute_instance),
        optional(random_qualifier),
        data_type_or_void,
        list_of_variable_decl_assignments,
        ";",
    )
}

rule data_type_or_void {
    choice(
        data_type,
        "void",
    )
}

rule struct_union {
    choice(
        "struct",
        seq("union", optional("tagged")),
    )
}

rule type_reference {
    seq(
        "type", "(",
        choice(
            expression,
            data_type,
        ),
        ")",
    )
}

// A.2.2.2 Strengths

rule drive_strength {
    seq(
        "(",
        choice(
            seq(strength0, ",", strength1),
            seq(strength1, ",", strength0),
            seq(strength0, ",", "highz1"),
            seq(strength1, ",", "highz0"),
            seq("highz0", ",", strength1),
            seq("highz1", ",", strength0),
        ),
        ")",
    )
}

rule strength0 { choice("supply0", "strong0", "pull0", "weak0") }

rule strength1 { choice("supply1", "strong1", "pull1", "weak1") }

rule charge_strength { seq("(", choice("small", "medium", "large"), ")") }

// A.2.2.3 Delays

rule delay3 {
    seq("#", choice(
        delay_value,
        seq(
            "(", mintypmax_expression,
            dsl::optseq([mintypmax_expression,
                optional(mintypmax_expression)],
            ),
            ")",
        ),
    ))
}

rule delay2 {
    seq("#", choice(
        delay_value,
        seq("(", mintypmax_expression, optional(mintypmax_expression), ")"),
    ))
}

rule delay_value {
    choice(
        unsigned_number,
        real_number,
        ps_identifier,
        time_literal,
        "1step",
    )
}

// A.2.3 Declaration lists

rule list_of_defparam_assignments { dsl::sep1(",", defparam_assignment) }

rule list_of_genvar_identifiers { dsl::sep1(",", genvar_identifier) }

rule list_of_interface_identifiers {
    dsl::sep1(",", seq(
        interface_identifier,
        repeat(unpacked_dimension),
    ))
}

rule list_of_net_decl_assignments { dsl::sep1(",", net_decl_assignment) }

rule list_of_param_assignments { dsl::sep1(",", param_assignment) }

rule list_of_port_identifiers {
    dsl::sep1(",", seq(
        port_identifier,
        repeat(unpacked_dimension),
    ))
}

rule list_of_udp_port_identifiers { dsl::sep1(",", port_identifier) }

rule list_of_specparam_assignments { dsl::sep1(",", specparam_assignment) }

rule list_of_tf_variable_identifiers {
    dsl::sep1(",", seq(
        port_identifier,
        repeat(_variable_dimension),
        dsl::optseq(["=", expression]),
    ))
}

rule list_of_type_assignments { dsl::sep1(",", type_assignment) }

rule list_of_variable_decl_assignments { dsl::sep1(",", variable_decl_assignment) }

rule list_of_variable_identifiers {
    dsl::sep1(",", seq(
        _variable_identifier,
        repeat(_variable_dimension),
    ))
}

rule list_of_variable_port_identifiers {
    dsl::sep1(",", seq(
        port_identifier,
        repeat(_variable_dimension),
        dsl::optseq(["=", constant_expression]),
    ))
}

// A.2.4 Declaration assignments

rule defparam_assignment {
    seq(
        _hierarchical_parameter_identifier,
        "=",
        constant_mintypmax_expression,
    )
}

rule net_decl_assignment {
    prec_left(dsl::PREC.ASSIGN, seq(
        _net_identifier,
        repeat(unpacked_dimension),
        dsl::optseq(["=", expression]),
    ))
}

rule param_assignment {
    seq(
        parameter_identifier,
        repeat(unpacked_dimension),
        dsl::optseq(["=", constant_param_expression]),
    )
}

rule specparam_assignment {
    choice(
        seq(specparam_identifier, "=", constant_mintypmax_expression),
        pulse_control_specparam,
    )
}

rule type_assignment {
    seq(
        _type_identifier,
        dsl::optseq(["=", data_type]),
    )
}

rule pulse_control_specparam {
    choice(
        seq(
            "PATHPULSE$=",
            "(",
            reject_limit_value,
            dsl::optseq([",", error_limit_value]),
            ")",
        ),
        // seq(
        //   'PATHPULSE$',
        //   $.specify_input_terminal_descriptor,
        //   '$',
        //   $.specify_output_terminal_descriptor,
        //   '=', '(', $.reject_limit_value, optseq(',', $.error_limit_value), ')'
        // )
    )
}

rule error_limit_value { limit_value }

rule reject_limit_value { limit_value }

rule limit_value { constant_mintypmax_expression }

rule variable_decl_assignment {
    choice(
        seq(
            _variable_identifier,
            repeat(_variable_dimension),
            dsl::optseq(["=", expression]),
        ),
        seq(
            dynamic_array_variable_identifier,
            unsized_dimension,
            repeat(_variable_dimension),
            dsl::optseq(["=", dynamic_array_new]),
        ),
        seq(
            class_variable_identifier,
            dsl::optseq(["=", class_new]),
        ),
    )
}

rule class_new {
    choice(
        seq(
            optional(class_scope), "new", optional(list_of_arguments_parent),
        ),
        seq("new", expression),
    )
}

rule dynamic_array_new {
    seq(
        "new", "[", expression, "]", dsl::optseq(["(", expression, ")"]),
    )
}

// A.2.5 Declaration ranges

rule unpacked_dimension {
    seq(
        "[", choice(
            constant_range,
            constant_expression,
        ), "]",
    )
}

rule packed_dimension {
    choice(
        seq("[", constant_range, "]"),
        unsized_dimension,
    )
}

rule associative_dimension {
    seq(
        "[", choice(data_type, "*"), "]",
    )
}

rule _variable_dimension {
    choice(
        unsized_dimension,
        unpacked_dimension,
        associative_dimension,
        queue_dimension,
    )
}

rule queue_dimension {
    seq(
        "[", "$", dsl::optseq([":", constant_expression]), "]",
    )
}

rule unsized_dimension { seq("[", "]") }

// A.2.6 Function declarations

rule function_data_type_or_implicit1 {
    choice(
        data_type_or_void,
        implicit_data_type1,
    )
}

rule function_declaration {
    seq(
        "function",
        optional(lifetime),
        function_body_declaration,
    )
}

rule function_body_declaration {
    seq(
        optional(function_data_type_or_implicit1),
        optional(choice(
            seq(interface_identifier, "."),
            class_scope,
        )),
        function_identifier,
        choice(
            seq(
                ";",
                repeat(tf_item_declaration),
            ),
            seq(
                "(", optional(tf_port_list), ")", ";",
                repeat(block_item_declaration),
            ),
        ),
        repeat(function_statement_or_null),
        "endfunction",
        dsl::optseq([":", function_identifier]),
    )
}

rule function_prototype {
    seq(
        "function",
        data_type_or_void,
        function_identifier,
        dsl::optseq(
            ["(", optional(tf_port_list), ")"],
        ),
    )
}

rule dpi_import_export {
    choice(
        seq(
            "import",
            dpi_spec_string,
            optional(dpi_function_import_property),
            dsl::optseq([c_identifier, "="]),
            dpi_function_proto,
            ";",
        ),
        seq(
            "import",
            dpi_spec_string,
            optional(dpi_task_import_property),
            dsl::optseq([c_identifier, "="]),
            dpi_task_proto,
            ";",
        ),
        seq(
            "export",
            dpi_spec_string,
            dsl::optseq([c_identifier, "="]),
            "function",
            function_identifier,
            ";",
        ),
        seq(
            "export",
            dpi_spec_string,
            dsl::optseq([c_identifier, "="]),
            "task",
            task_identifier,
            ";",
        ),
    )
}

rule dpi_spec_string { choice("\"DPI-C\"", "\"DPI\"") }

rule dpi_function_import_property { choice("context", "pure") }

rule dpi_task_import_property { "context" }

rule dpi_function_proto { function_prototype }

rule dpi_task_proto { task_prototype }

// A.2.7 Task declarations

rule task_declaration {
    seq(
        "task",
        optional(lifetime),
        task_body_declaration,
    )
}

rule task_body_declaration {
    seq(
        optional(choice(
            seq(interface_identifier, "."),
            class_scope,
        )),
        task_identifier,
        choice(
            seq(
                ";",
                repeat(tf_item_declaration),
            ),
            seq(
                "(", optional(tf_port_list), ")", ";",
                repeat(block_item_declaration),
            ),
        ),
        repeat(statement_or_null),
        "endtask",
        dsl::optseq([":", task_identifier]),
    )
}

rule tf_item_declaration {
    choice(
        block_item_declaration,
        tf_port_declaration,
    )
}

rule tf_port_list { dsl::sep1(",", tf_port_item1) }

rule tf_port_item1 {
    seq(
        repeat(attribute_instance),
        optional(tf_port_direction),
        optional("var"),
        choice(
            seq(
                data_type_or_implicit1,
                dsl::optseq(
                    [port_identifier,
                    repeat(_variable_dimension),
                    dsl::optseq(["=", expression])],
                ),
            ),
            seq(
                port_identifier,
                repeat(_variable_dimension),
                dsl::optseq(["=", expression]),
            ),
        ),
    )
}

rule tf_port_direction {
    choice(
        port_direction,
        seq("const", "ref"),
    )
}

rule tf_port_declaration {
    seq(
        repeat(attribute_instance),
        tf_port_direction,
        optional("var"),
        optional(data_type_or_implicit1),
        list_of_tf_variable_identifiers,
        ";",
    )
}

rule task_prototype {
    seq(
        "task",
        task_identifier,
        dsl::optseq(["(", optional(tf_port_list), ")"]),
    )
}

// A.2.8 Block item declarations

rule block_item_declaration {
    seq(
        repeat(attribute_instance),
        choice(
            data_declaration,
            seq(_any_parameter_declaration, ";"),
            overload_declaration,
            let_declaration,
        ),
    )
}

rule overload_declaration {
    seq(
        "bind",
        overload_operator,
        "function",
        data_type,
        function_identifier,
        "(",
        overload_proto_formals,
        ")",
        ";",
    )
}

rule overload_operator { choice("+", "++", "–", "––", "*", "**", "/", "%", "==", "!=", "<", "<=", ">", ">=", "=") }

rule overload_proto_formals { dsl::sep1(",", data_type) }

// A.2.9 Interface declarations

rule modport_declaration { seq("modport", dsl::sep1(",", modport_item), ";") }

rule modport_item {
    seq(
        modport_identifier,
        "(", dsl::sep1(",", modport_ports_declaration), ")",
    )
}

rule modport_ports_declaration {
    seq(
        repeat(attribute_instance),
        choice(
            modport_simple_ports_declaration,
            modport_tf_ports_declaration,
            modport_clocking_declaration,
        ),
    )
}

rule modport_clocking_declaration { seq("clocking", clocking_identifier) }

rule modport_simple_ports_declaration {
    seq(
        port_direction,
        dsl::sep1(",", modport_simple_port),
    )
}

rule modport_simple_port {
    choice(
        port_identifier,
        seq(".", port_identifier, "(", optional(expression), ")"),
    )
}

rule modport_tf_ports_declaration {
    seq(
        import_export, dsl::sep1(",", _modport_tf_port),
    )
}

rule _modport_tf_port {
    choice(
        _method_prototype,
        tf_identifier,
    )
}

rule import_export { choice("import", "export") }

// A.2.10 Assertion declarations

rule concurrent_assertion_item {
    choice(
        seq(
            dsl::optseq([_block_identifier, ":"]),
            _concurrent_assertion_statement,
        ),
        checker_instantiation,
    )
}

rule _concurrent_assertion_statement {
    choice(
        assert_property_statement,
        assume_property_statement,
        cover_property_statement,
        cover_sequence_statement,
        restrict_property_statement,
    )
}

rule assert_property_statement {
    seq(
        "assert", "property", "(", property_spec, ")", action_block,
    )
}

rule assume_property_statement {
    seq(
        "assume", "property", "(", property_spec, ")", action_block,
    )
}

rule cover_property_statement {
    seq(
        "cover", "property", "(", property_spec, ")", statement_or_null,
    )
}

rule expect_property_statement {
    seq(
        "expect", "(", property_spec, ")", action_block,
    )
}

rule cover_sequence_statement {
    seq(
        "cover", "sequence", "(",
        optional(clocking_event),
        optional(prec_right(dsl::PREC.iff, seq(
            "disable", "iff", "(", expression_or_dist, ")",
        ))),
        sequence_expr,
        ")",
        statement_or_null,
    )
}

rule restrict_property_statement {
    seq(
        "restrict", "property", "(", property_spec, ")", ";",
    )
}

rule property_instance {
    seq(
        ps_or_hierarchical_property_identifier,
        dsl::optseq(["(", optional(property_list_of_arguments), ")"]),
    )
}

rule property_list_of_arguments {
    choice(
        seq(
            dsl::sep1(",", optional(_property_actual_arg)),
            repeat1(seq( // TODO remove 1
                ",", ".", _identifier, "(", optional(_property_actual_arg), ")",
            )),
        ),
        dsl::sep1(",", seq(
            ".", _identifier, "(", optional(_property_actual_arg), ")",
        )),
    )
}

rule _property_actual_arg {
    choice(
        property_expr,
        _sequence_actual_arg,
    )
}

rule _assertion_item_declaration {
    choice(
        property_declaration,
        sequence_declaration,
        let_declaration,
    )
}

rule property_declaration {
    seq(
        "property",
        property_identifier,
        dsl::optseq(["(", optional(property_port_list), ")"]),
        ";",
        repeat(assertion_variable_declaration),
        property_spec,
        optional(";"),
        "endproperty", dsl::optseq([":", property_identifier]),
    )
}

rule property_port_list { dsl::sep1(",", property_port_item) }

rule property_port_item {
    seq(
        repeat(attribute_instance),
        dsl::optseq(
            ["local",
            optional(property_lvar_port_direction)],
        ),
        optional(property_formal_type1),
        formal_port_identifier,
        repeat(_variable_dimension),
        dsl::optseq(["=", _property_actual_arg]),
    )
}

rule property_lvar_port_direction { "input" }

rule property_formal_type1 {
    choice(
        sequence_formal_type1,
        "property",
    )
}

rule property_spec {
    seq(
        optional(clocking_event),
        optional(prec_right(dsl::PREC.iff, seq(
            "disable", "iff", "(", expression_or_dist, ")",
        ))),
        property_expr,
    )
}

rule property_expr {
    choice(
        sequence_expr,
        seq("strong", "(", sequence_expr, ")"),
        seq("weak", "(", sequence_expr, ")"),
        prec_left(dsl::PREC.PARENT, seq("(", property_expr, ")")),

        // FIXME no assosiativity rules per spec
        prec_left(dsl::PREC.nexttime, seq("not", property_expr)),
        prec_left(dsl::PREC.or, seq(property_expr, "or", property_expr)),
        prec_left(dsl::PREC.and, seq(property_expr, "and", property_expr)),

        prec_right(dsl::PREC.INCIDENCE, seq(sequence_expr, "|->", property_expr)),
        prec_right(dsl::PREC.INCIDENCE, seq(sequence_expr, "|=>", property_expr)),

        // FIXME no assosiativity rules per spec
        prec_left(0, seq("if", "(", expression_or_dist, ")", property_expr, dsl::optseq(["else", property_expr]))), // FIXME spec bug ( ) are not red

        seq("case", "(", expression_or_dist, ")", repeat1(property_case_item), "endcase"),  // FIXME spec bug ( ) are not red
        prec_right(dsl::PREC.INCIDENCE, seq(sequence_expr, "#-#", property_expr)),
        prec_right(dsl::PREC.INCIDENCE, seq(sequence_expr, "#=#", property_expr)),

        // FIXME no assosiativity rules per spec
        prec_left(dsl::PREC.nexttime, seq("nexttime", property_expr)),
        prec_left(dsl::PREC.nexttime, seq("nexttime", "[", constant_expression, "]", property_expr)), // FIXME spec bug constant _expression with the space
        prec_left(dsl::PREC.nexttime, seq("s_nexttime", property_expr)),
        prec_left(dsl::PREC.nexttime, seq("s_nexttime", "[", constant_expression, "]", property_expr)),

        prec_left(dsl::PREC.always, seq("always", property_expr)),
        prec_left(dsl::PREC.always, seq("always", "[", cycle_delay_const_range_expression, "]", property_expr)),
        prec_left(dsl::PREC.always, seq("s_always", "[", constant_range, "]", property_expr)),
        prec_left(dsl::PREC.always, seq("s_eventually", property_expr)),
        prec_left(dsl::PREC.always, seq("eventually", "[", constant_range, "]", property_expr)),
        prec_left(dsl::PREC.always, seq("s_eventually", "[", cycle_delay_const_range_expression, "]", property_expr)),

        prec_right(dsl::PREC.until, seq(property_expr,
            choice("until", "s_until", "until_with", "s_until_with", "implies"),
            property_expr,
        )),

        prec_right(dsl::PREC.iff, seq(property_expr, "iff", property_expr)),

        // FIXME no assosiativity rules per spec
        prec_left(dsl::PREC.always, seq(
            choice("accept_on", "reject_on", "sync_accept_on", "sync_reject_on"),
            "(", expression_or_dist, ")", property_expr,
        )),
        // $.property_instance,
        prec_left(0, seq(clocking_event, property_expr)), // FIXME no assosiativity rules per spec
    )
}

rule property_case_item {
    choice(
        seq(
            dsl::sep1(",", expression_or_dist), ":", property_expr, ";",
        ),
        seq(
            "default", optional(":"), property_expr, ";",
        ),
    )
}

rule sequence_declaration {
    seq(
        "sequence",
        _sequence_identifier,
        dsl::optseq(
            ["(", optional(sequence_port_list), ")"],
        ),
        ";",
        repeat(assertion_variable_declaration),
        sequence_expr,
        optional(";"),
        "endsequence", dsl::optseq([":", _sequence_identifier]),
    )
}

rule sequence_port_list { dsl::sep1(",", sequence_port_item) }

rule sequence_port_item {
    seq(
        repeat(attribute_instance),
        dsl::optseq(
            ["local",
            optional(sequence_lvar_port_direction)],
        ),
        optional(sequence_formal_type1),
        formal_port_identifier,
        repeat(_variable_dimension),
        dsl::optseq(
            ["=", _sequence_actual_arg],
        ),
    )
}

rule sequence_lvar_port_direction { choice("input", "inout", "output") }

rule sequence_formal_type1 {
    choice(
        data_type_or_implicit1,
        "sequence",
        "untyped",
    )
}

rule sequence_expr {
    choice(
        prec_left(0, dsl::sep1(",", cycle_delay_range)), // FIXME precedence?
        prec_left(dsl::PREC.SHARP2, seq(sequence_expr, repeat1(seq(cycle_delay_range, sequence_expr)))),
        seq(expression_or_dist, optional(_boolean_abbrev)),
        seq(sequence_instance, optional(sequence_abbrev)),
        prec_left(0, seq("(", sequence_expr, dsl::repseq([",", _sequence_match_item]), ")", optional(sequence_abbrev))),
        prec_left(dsl::PREC.and, seq(sequence_expr, "and", sequence_expr)),
        prec_left(dsl::PREC.intersect, seq(sequence_expr, "intersect", sequence_expr)),
        prec_left(dsl::PREC.or, seq(sequence_expr, "or", sequence_expr)),
        seq("first_match", "(", sequence_expr, dsl::repseq([",", _sequence_match_item]), ")"),
        prec_right(dsl::PREC.throughout, seq(expression_or_dist, "throughout", sequence_expr)),
        prec_left(dsl::PREC.within, seq(sequence_expr, "within", sequence_expr)),
        prec_left(0, seq(clocking_event, sequence_expr)), // FIXME precedence?
    )
}

rule cycle_delay_range {
    choice(
        prec_left(0, seq("##", constant_primary)),
        prec_left(0, seq("##", "[", cycle_delay_const_range_expression, "]")),
        "##[*]",
        "##[+]",
    )
}

rule sequence_method_call { seq(sequence_instance, ".", method_identifier) }

rule _sequence_match_item {
    choice(
        operator_assignment,
        inc_or_dec_expression,
        subroutine_call,
    )
}

rule sequence_instance {
    seq(
        ps_or_hierarchical_sequence_identifier,
        dsl::optseq(["(", optional(sequence_list_of_arguments), ")"]),
    )
}

rule sequence_list_of_arguments {
    choice(
        // seq(
        //   sep1(',', optional($._sequence_actual_arg)),
        //   repseq(',', '.', $._identifier, '(', optional($._sequence_actual_arg), ')')
        // ),
        dsl::sep1(",", seq(".", _identifier, "(", optional(_sequence_actual_arg), ")")),
    )
}

rule _sequence_actual_arg {
    choice(
        event_expression,
        sequence_expr,
    )
}

rule _boolean_abbrev {
    choice(
        consecutive_repetition,
        non_consecutive_repetition,
        goto_repetition,
    )
}

rule sequence_abbrev { consecutive_repetition }

rule consecutive_repetition {
    choice(
        seq("[*", _const_or_range_expression, "]"),
        "[*]",
        "[+]",
    )
}

rule non_consecutive_repetition { seq("[=", _const_or_range_expression, "]") }

rule goto_repetition { seq("[->", _const_or_range_expression, "]") }

rule _const_or_range_expression {
    choice(
        constant_expression,
        cycle_delay_const_range_expression,
    )
}

rule cycle_delay_const_range_expression {
    choice(
        seq(constant_expression, ":", constant_expression),
        seq(constant_expression, ":", "$"),
    )
}

rule expression_or_dist {
    seq(
        expression,
        optional(prec_left(dsl::PREC.RELATIONAL, seq("dist", "{", dist_list, "}"))),
    )
}

rule assertion_variable_declaration {
    seq(
        _var_data_type,
        list_of_variable_decl_assignments,
        ";",
    )
}

// A.2.11 Covergroup declarations

rule covergroup_declaration {
    seq(
        "covergroup", covergroup_identifier,
        dsl::optseq(["(", optional(tf_port_list), ")"]),
        optional(coverage_event),
        ";",
        repeat(coverage_spec_or_option),
        "endgroup", dsl::optseq([":", covergroup_identifier]),
    )
}

rule coverage_spec_or_option {
    choice(
        seq(repeat(attribute_instance), _coverage_spec),
        seq(repeat(attribute_instance), coverage_option, ";"),
    )
}

rule coverage_option {
    choice(
        seq("option", ".", member_identifier, "=", expression),
        seq("type_option", ".", member_identifier, "=", constant_expression),
    )
}

rule _coverage_spec { choice(cover_point, cover_cross) }

rule coverage_event {
    choice(
        clocking_event,
        seq("with", "function", "sample", "(", optional(tf_port_list), ")"),
        seq("@@", "(", block_event_expression, ")"),
    )
}

rule block_event_expression {
    choice(
        prec_left(dsl::PREC.or, seq(block_event_expression, "or", block_event_expression)),
        seq("begin", hierarchical_btf_identifier),
        seq("end", hierarchical_btf_identifier),
    )
}

rule hierarchical_btf_identifier {
    choice(
        _hierarchical_tf_identifier,
        _hierarchical_block_identifier,
        prec_left(dsl::PREC.PARENT, seq(
            choice(seq(hierarchical_identifier, "."), class_scope),
            method_identifier,
        )),
    )
}

rule cover_point {
    seq(
        dsl::optseq([optional(data_type_or_implicit1), cover_point_identifier, ":"]),
        "coverpoint", expression,
        optional(prec_right(dsl::PREC.iff, seq("iff", "(", expression, ")"))),
        bins_or_empty,
    )
}

rule bins_or_empty {
    choice(
        seq("{", repeat(attribute_instance), dsl::repseq([bins_or_options, ";"]), "}"),
        ";",
    )
}

rule bins_or_options {
    choice(
        coverage_option,
        seq(
            "wildcard",
            bins_keyword,
            _bin_identifier,
            dsl::optseq(["[", optional(_covergroup_expression), "]"]),
            "=",
            "{", covergroup_range_list, "}",
            dsl::optseq(["with", "(", _with_covergroup_expression, ")"]),
            optional(prec_right(dsl::PREC.iff, seq("iff", "(", expression, ")"))),
        ),
        seq(
            "wildcard",
            bins_keyword,
            _bin_identifier,
            dsl::optseq(["[", optional(_covergroup_expression), "]"]),
            "=",
            cover_point_identifier,
            "with", "(", _with_covergroup_expression, ")",
            optional(prec_right(dsl::PREC.iff, seq("iff", "(", expression, ")"))),
        ),
        seq(
            "wildcard",
            bins_keyword,
            _bin_identifier,
            dsl::optseq(["[", optional(_covergroup_expression), "]"]),
            "=",
            _set_covergroup_expression,
            optional(prec_right(dsl::PREC.iff, seq("iff", "(", expression, ")"))),
        ),
        seq(
            "wildcard",
            bins_keyword,
            _bin_identifier,
            dsl::optseq(["[", "]"]),
            "=",
            trans_list,
            optional(prec_right(dsl::PREC.iff, seq("iff", "(", expression, ")"))),
        ),
        seq(
            bins_keyword,
            _bin_identifier,
            dsl::optseq(["[", optional(_covergroup_expression), "]"]),
            "=",
            "default",
            optional(prec_right(dsl::PREC.iff, seq("iff", "(", expression, ")"))),
        ),
        seq(
            bins_keyword,
            _bin_identifier,
            "=",
            "default",
            "sequence",
            optional(prec_right(dsl::PREC.iff, seq("iff", "(", expression, ")"))),
        ),
    )
}

rule bins_keyword { choice("bins", "illegal_bins", "ignore_bins") }

rule trans_list { dsl::sep1(",", seq("(", trans_set, ")")) }

rule trans_set { dsl::sep1("=>", trans_range_list) }

rule trans_range_list {
    choice(
        trans_item,
        seq(trans_item, "[*", repeat_range, "]"),
        seq(trans_item, "[–>", repeat_range, "]"),
        seq(trans_item, "[=", repeat_range, "]"),
    )
}

rule trans_item { covergroup_range_list }

rule repeat_range {
    seq(
        _covergroup_expression, dsl::optseq([":", _covergroup_expression]),
    )
}

rule cover_cross {
    seq(
        dsl::optseq([cross_identifier, ":"]),
        "cross",
        list_of_cross_items,
        optional(prec_right(dsl::PREC.iff, seq("iff", "(", expression, ")"))),
        cross_body,
    )
}

rule list_of_cross_items { seq(_cross_item, ",", dsl::sep1(",", _cross_item)) }

rule _cross_item {
    choice(
        cover_point_identifier,
        // $._variable_identifier
    )
}

rule cross_body {
    choice(
        seq("{", dsl::repseq([cross_body_item, ";"]), "}"),
        ";",
    )
}

rule cross_body_item {
    choice(
        function_declaration, // FIXME standard function_declaraton => function_declaration
        seq(bins_selection_or_option, ";"),
    )
}

rule bins_selection_or_option {
    choice(
        seq(repeat(attribute_instance), coverage_option),
        seq(repeat(attribute_instance), bins_selection),
    )
}

rule bins_selection {
    seq(
        bins_keyword, _bin_identifier, "=", select_expression,
        optional(prec_right(dsl::PREC.iff, seq("iff", "(", expression, ")"))),
    )
}

rule select_expression {
    choice(
        select_condition,
        prec_left(dsl::PREC.UNARY, seq("!", select_condition)),
        prec_left(dsl::PREC.LOGICAL_AND, seq(select_expression, "&&", select_expression)),
        prec_left(dsl::PREC.LOGICAL_OR, seq(select_expression, "||", select_expression)),
        prec_left(dsl::PREC.PARENT, seq("(", select_expression, ")")),
        seq(
            select_expression, "with", "(", _with_covergroup_expression, ")",
            dsl::optseq(["matches", _integer_covergroup_expression]),
        ),
        cross_identifier,
        seq(
            _cross_set_expression,
            dsl::optseq(["matches", _integer_covergroup_expression]),
        ),
    )
}

rule select_condition {
    seq(
        "binsof", "(", bins_expression, ")",
        dsl::optseq(["intersect", "{", covergroup_range_list, "}"]),
    )
}

rule bins_expression {
    choice(
        _variable_identifier,
        prec_left(dsl::PREC.PARENT, seq(cover_point_identifier, dsl::optseq([".", _bin_identifier]))),
    )
}

rule covergroup_range_list { dsl::sep1(",", covergroup_value_range) }

rule covergroup_value_range {
    choice(
        _covergroup_expression,
        seq("[", _covergroup_expression, ":", _covergroup_expression, "]"),
    )
}

rule _with_covergroup_expression { _covergroup_expression }

rule _set_covergroup_expression { _covergroup_expression }

rule _integer_covergroup_expression { _covergroup_expression }

rule _cross_set_expression { _covergroup_expression }

rule _covergroup_expression { expression }

// A.2.12 Let declarations

rule let_declaration {
    seq(
        "let", let_identifier,
        dsl::optseq(["(", optional(let_port_list), ")"]),
        "=", expression, ";",
    )
}

rule let_identifier { _identifier }

rule let_port_list { dsl::sep1(",", let_port_item) }

rule let_port_item {
    seq(
        repeat(attribute_instance),
        optional(let_formal_type1),
        formal_port_identifier,
        repeat(_variable_dimension),
        dsl::optseq(["=", expression]),
    )
}

rule let_formal_type1 {
    choice(
        data_type_or_implicit1,
        "untyped",
    )
}

rule let_expression {
    prec_left(0, seq(
        optional(package_scope),
        let_identifier,
        dsl::optseq(["(", optional(let_list_of_arguments), ")"]),
    ))
}

rule let_list_of_arguments {
    choice(
        // FIXME empty string
        // seq(
        //   sep1(',', optional($.let_actual_arg)),
        //   repseq(',', '.', $._identifier, '(', optional($.let_actual_arg), ')')
        // ),
        dsl::sep1(",", seq(".", _identifier, "(", optional(let_actual_arg), ")")),
    )
}

rule let_actual_arg { expression }
