        genvar_identifier,
        repeat(prec_left(0, seq(
            ",",
            genvar_identifier,
        ))),
    ))
}

rule list_of_interface_identifiers {
    prec_left(0, seq(
        seq(
            interface_identifier,
            repeat(unpacked_dimension),
        ),
        repeat(prec_left(0, seq(
            ",",
            seq(
                interface_identifier,
                repeat(unpacked_dimension),
            ),
        ))),
    ))
}

rule list_of_net_decl_assignments {
