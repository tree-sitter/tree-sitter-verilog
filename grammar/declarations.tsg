rule local_parameter_declaration {
    seq(
        "localparam",
        choice(
            seq(
                choice(
                    data_type_or_implicit1,
                    blank(),
                ),
                list_of_param_assignments,
            ),
            seq(
                "type",
                list_of_type_assignments,
            ),
        ),
    )
}

rule parameter_declaration {
    seq(
        "parameter",
        choice(
            seq(
                choice(
                    data_type_or_implicit1,
                    blank(),
                ),
                list_of_param_assignments,
            ),
            seq(
                "type",
                list_of_type_assignments,
            ),
        ),
    )
}

rule _any_parameter_declaration {
    choice(
        local_parameter_declaration,
        parameter_declaration,
    )
}

rule specparam_declaration {
    seq(
        "specparam",
        choice(
            packed_dimension,
            blank(),
        ),
        list_of_specparam_assignments,
        ";",
    )
}

rule inout_declaration {
    seq(
        "inout",
        choice(
            net_port_type1,
            blank(),
        ),
        list_of_port_identifiers,
    )
}

rule input_declaration {
    seq(
        "input",
        choice(
            seq(
                choice(
                    net_port_type1,
                    blank(),
                ),
                list_of_port_identifiers,
            ),
            seq(
                choice(
                    _variable_port_type,
                    blank(),
                ),
                list_of_variable_identifiers,
            ),
        ),
    )
}

rule output_declaration {
    seq(
        "output",
        choice(
            seq(
                choice(
                    net_port_type1,
                    blank(),
                ),
                list_of_port_identifiers,
            ),
            seq(
                choice(
                    _variable_port_type,
                    blank(),
                ),
                list_of_variable_port_identifiers,
            ),
        ),
    )
}

rule interface_port_declaration {
    seq(
        interface_identifier,
        choice(
            prec_left(0, seq(
                ".",
                modport_identifier,
            )),
            blank(),
        ),
        list_of_interface_identifiers,
    )
}

rule ref_declaration {
    seq(
        "ref",
        _variable_port_type,
        list_of_variable_identifiers,
    )
}

rule data_declaration {
    choice(
        seq(
            choice(
                "const",
                blank(),
            ),
            choice(
                "var",
                blank(),
            ),
            choice(
                lifetime,
                blank(),
            ),
            choice(
                data_type_or_implicit1,
                blank(),
            ),
            list_of_variable_decl_assignments,
            ";",
        ),
        type_declaration,
        package_import_declaration,
        net_type_declaration,
    )
}

rule package_import_declaration {
    seq(
        "import",
        prec_left(0, seq(
            package_import_item,
            repeat(prec_left(0, seq(
                ",",
                package_import_item,
            ))),
        )),
        ";",
    )
}

rule package_import_item {
    seq(
        package_identifier,
        "::",
        choice(
            _identifier,
            "*",
        ),
    )
}

rule package_export_declaration {
    seq(
        "export",
        choice(
            "*::*",
            prec_left(0, seq(
                package_import_item,
                repeat(prec_left(0, seq(
                    ",",
                    package_import_item,
                ))),
            )),
        ),
        ";",
    )
}

rule genvar_declaration {
    seq(
        "genvar",
        list_of_genvar_identifiers,
        ";",
    )
}

rule net_declaration {
    choice(
        seq(
            net_type,
            choice(
                choice(
                    drive_strength,
                    charge_strength,
                ),
                blank(),
            ),
            choice(
                choice(
                    "vectored",
                    "scalared",
                ),
                blank(),
            ),
            choice(
                data_type_or_implicit1,
                blank(),
            ),
            choice(
                delay3,
                blank(),
            ),
            list_of_net_decl_assignments,
            ";",
        ),
        seq(
            _net_type_identifier,
            choice(
                delay_control,
                blank(),
            ),
            list_of_net_decl_assignments,
            ";",
        ),
        seq(
            "interconnect",
            choice(
                implicit_data_type1,
                blank(),
            ),
            choice(
                prec_left(0, seq(
                    "#",
                    delay_value,
                )),
                blank(),
            ),
            prec_left(0, seq(
                seq(
                    _net_identifier,
                    repeat(unpacked_dimension),
                ),
                repeat(prec_left(0, seq(
                    ",",
                    seq(
                        _net_identifier,
                        repeat(unpacked_dimension),
                    ),
                ))),
            )),
            ";",
        ),
    )
}

rule type_declaration {
    seq(
        "typedef",
        choice(
            seq(
                data_type,
                _type_identifier,
                repeat(_variable_dimension),
            ),
            seq(
                interface_instance_identifier,
                choice(
                    constant_bit_select1,
                    blank(),
                ),
                ".",
                _type_identifier,
                _type_identifier,
            ),
            seq(
                choice(
                    choice(
                        "enum",
                        "struct",
                        "union",
                        "class",
                        seq(
                            "interface",
                            "class",
                        ),
                    ),
                    blank(),
                ),
                _type_identifier,
            ),
        ),
        ";",
    )
}

rule net_type_declaration {
    seq(
        "nettype",
        choice(
            seq(
                data_type,
                _net_type_identifier,
                choice(
                    prec_left(0, seq(
                        "with",
                        choice(
                            choice(
                                package_scope,
                                class_scope,
                            ),
                            blank(),
                        ),
                        tf_identifier,
                    )),
                    blank(),
                ),
            ),
            seq(
                choice(
                    choice(
                        package_scope,
                        class_scope,
                    ),
                    blank(),
                ),
                _net_type_identifier,
                _net_type_identifier,
            ),
        ),
        ";",
    )
}

rule lifetime {
    choice(
        "static",
        "automatic",
    )
}

rule casting_type {
    choice(
        _simple_type,
        constant_primary,
        _signing,
        "string",
        "const",
    )
}

rule data_type {
    choice(
        seq(
            integer_vector_type,
            choice(
                _signing,
                blank(),
            ),
            repeat(packed_dimension),
        ),
        seq(
            integer_atom_type,
            choice(
                _signing,
                blank(),
            ),
        ),
        non_integer_type,
        seq(
            struct_union,
            choice(
                prec_left(0, seq(
                    "packed",
                    choice(
                        _signing,
                        blank(),
                    ),
                )),
                blank(),
            ),
            "{",
            repeat1(struct_union_member),
            "}",
            repeat(packed_dimension),
        ),
        seq(
            "enum",
            choice(
                enum_base_type,
                blank(),
            ),
            "{",
            prec_left(0, seq(
                enum_name_declaration,
                repeat(prec_left(0, seq(
                    ",",
                    enum_name_declaration,
                ))),
            )),
            "}",
            repeat(packed_dimension),
        ),
        "string",
        "chandle",
        prec_left(0, seq(
            "virtual",
            choice(
                "interface",
                blank(),
            ),
            interface_identifier,
            choice(
                parameter_value_assignment,
                blank(),
            ),
            choice(
                prec_left(0, seq(
                    ".",
                    modport_identifier,
                )),
                blank(),
            ),
        )),
        seq(
            choice(
                choice(
                    class_scope,
                    package_scope,
                ),
                blank(),
            ),
            _type_identifier,
            repeat(packed_dimension),
        ),
        class_type,
        "event",
        ps_covergroup_identifier,
        type_reference,
    )
}

rule data_type_or_implicit1 {
    choice(
        data_type,
        implicit_data_type1,
    )
}

rule implicit_data_type1 {
    choice(
        seq(
            _signing,
            repeat(packed_dimension),
        ),
        repeat1(packed_dimension),
    )
}

rule enum_base_type {
    choice(
        seq(
            integer_atom_type,
            choice(
                _signing,
                blank(),
            ),
        ),
        seq(
            integer_vector_type,
            choice(
                _signing,
                blank(),
            ),
            choice(
                packed_dimension,
                blank(),
            ),
        ),
        seq(
            _type_identifier,
            choice(
                packed_dimension,
                blank(),
            ),
        ),
    )
}

rule enum_name_declaration {
    seq(
        enum_identifier,
        choice(
            prec_left(0, seq(
                "[",
                integral_number,
                choice(
                    prec_left(0, seq(
                        ":",
                        integral_number,
                    )),
                    blank(),
                ),
                "]",
            )),
            blank(),
        ),
        choice(
            prec_left(0, seq(
                "=",
                constant_expression,
            )),
            blank(),
        ),
    )
}

rule class_scope {
    seq(
        class_type,
        "::",
    )
}

rule class_type {
    prec_right(0, seq(
        ps_class_identifier,
        choice(
            parameter_value_assignment,
            blank(),
        ),
        repeat(prec_left(0, seq(
            "::",
            class_identifier,
            choice(
                parameter_value_assignment,
                blank(),
            ),
        ))),
    ))
}

rule _integer_type {
    choice(
        integer_vector_type,
        integer_atom_type,
    )
}

rule integer_atom_type {
    choice(
        "byte",
        "shortint",
        "int",
        "longint",
        "integer",
        "time",
    )
}

rule integer_vector_type {
    choice(
        "bit",
        "logic",
        "reg",
    )
}

rule non_integer_type {
    choice(
        "shortreal",
        "real",
        "realtime",
    )
}

rule net_type {
    choice(
        "supply0",
        "supply1",
        "tri",
        "triand",
        "trior",
        "trireg",
        "tri0",
        "tri1",
        "uwire",
        "wire",
        "wand",
        "wor",
    )
}

rule net_port_type1 {
    choice(
        prec_left(-1, seq(
            net_type,
            data_type_or_implicit1,
        )),
        net_type,
        data_type_or_implicit1,
        _net_type_identifier,
        seq(
            "interconnect",
            choice(
                implicit_data_type1,
                blank(),
            ),
        ),
    )
}

rule _variable_port_type { _var_data_type }

rule _var_data_type {
    prec_left(0, choice(
        data_type,
        seq(
            "var",
            choice(
                data_type_or_implicit1,
                blank(),
            ),
        ),
    ))
}

rule _signing {
    choice(
        "signed",
        "unsigned",
    )
}

rule _simple_type {
    choice(
        _integer_type,
        non_integer_type,
        ps_type_identifier,
        ps_parameter_identifier,
    )
}

rule struct_union_member {
    seq(
        repeat(attribute_instance),
        choice(
            random_qualifier,
            blank(),
        ),
        data_type_or_void,
        list_of_variable_decl_assignments,
        ";",
    )
}

rule data_type_or_void {
    choice(
        data_type,
        "void",
    )
}

rule struct_union {
    choice(
        "struct",
        seq(
            "union",
            choice(
                "tagged",
                blank(),
            ),
        ),
    )
}

rule type_reference {
    seq(
        "type",
        "(",
        choice(
            expression,
            data_type,
        ),
        ")",
    )
}

rule drive_strength {
    seq(
        "(",
        choice(
            seq(
                strength0,
                ",",
                strength1,
            ),
            seq(
                strength1,
                ",",
                strength0,
            ),
            seq(
                strength0,
                ",",
                "highz1",
            ),
            seq(
                strength1,
                ",",
                "highz0",
            ),
            seq(
                "highz0",
                ",",
                strength1,
            ),
            seq(
                "highz1",
                ",",
                strength0,
            ),
        ),
        ")",
    )
}

rule strength0 {
    choice(
        "supply0",
        "strong0",
        "pull0",
        "weak0",
    )
}

rule strength1 {
    choice(
        "supply1",
        "strong1",
        "pull1",
        "weak1",
    )
}

rule charge_strength {
    seq(
        "(",
        choice(
            "small",
            "medium",
            "large",
        ),
        ")",
    )
}

rule delay3 {
    seq(
        "#",
        choice(
            delay_value,
            seq(
                "(",
                mintypmax_expression,
                choice(
                    prec_left(0, seq(
                        mintypmax_expression,
                        choice(
                            mintypmax_expression,
                            blank(),
                        ),
                    )),
                    blank(),
                ),
                ")",
            ),
        ),
    )
}

rule delay2 {
    seq(
        "#",
        choice(
            delay_value,
            seq(
                "(",
                mintypmax_expression,
                choice(
                    mintypmax_expression,
                    blank(),
                ),
                ")",
            ),
        ),
    )
}

rule delay_value {
    choice(
        unsigned_number,
        real_number,
        ps_identifier,
        time_literal,
        "1step",
    )
}

rule list_of_defparam_assignments {
    prec_left(0, seq(
        defparam_assignment,
        repeat(prec_left(0, seq(
            ",",
            defparam_assignment,
        ))),
    ))
}

rule list_of_genvar_identifiers {
